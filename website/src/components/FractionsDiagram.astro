---
/**
 * "One layout fits any monitor": the Priority template drawn on two monitors,
 * with the fractions that are stored and the pixel widths computed at build time
 * (same rounding as crates/krova-core/src/geometry.rs). A data table repeats the
 * numbers as text and adds a 1366 px wide laptop, where the rounding shows.
 */
import { denormalizeSpan, exampleMonitors, fmt, priorityZones } from '../lib/zones';

const drawn = exampleMonitors.slice(0, 2);
const laptop = exampleMonitors[2];

const fraction = (x: number, w: number): string => `${x} – ${+(x + w).toFixed(2)}`;

const W = 160;
const H = 90;
const gap = 1.6;
const spans = (size: number) => priorityZones.map((z) => denormalizeSpan(z, size));

const isHalf = (n: number) => Number.isInteger(n * 2) && !Number.isInteger(n);
// Laptop example, computed rather than typed: where does 0.25 / 0.75 land on its width?
const l25 = 0.25 * laptop.width;
const l75 = 0.75 * laptop.width;
const laptopSpans = spans(laptop.width);
const showRounding = isHalf(l25) || isHalf(l75);
---

<figure class="fr">
  <div class="monitors">
    {
      drawn.map((m) => {
        const s = spans(m.width);
        return (
          <div class="mon">
            <p class="mon-name">
              <span class="mono">{m.name}</span> px
            </p>
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`A ${m.name} monitor with three zones: ${s.map((p, i) => `zone ${i + 1} is ${fmt(p.width)} pixels wide`).join(', ')}.`}>
              <rect class="bezel" x="0.5" y="0.5" width={W - 1} height={H - 1} rx="5"></rect>
              {priorityZones.map((z, i) => (
                <g>
                  <rect
                    class:list={['zone', { mid: i === 1 }]}
                    x={(z.x * (W - 6) + 3 + gap / 2).toFixed(2)}
                    y="4"
                    width={(z.w * (W - 6) - gap).toFixed(2)}
                    height={H - 8}
                    rx="3"
                  ></rect>
                  <text class="n" x={(z.x * (W - 6) + 3 + (z.w * (W - 6)) / 2).toFixed(2)} y={H / 2 + 4}>{z.id}</text>
                </g>
              ))}
            </svg>
            <div class="cols" aria-hidden="true">
              {priorityZones.map((z, i) => (
                <div class="col">
                  <span class="mono frac">{fraction(z.x, z.w)}</span>
                  <span class="px">{fmt(s[i].width)} px</span>
                </div>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="table-scroll" tabindex="0" role="region" aria-label="Zone edges in pixels for three monitor sizes">
    <table class="data-table">
      <caption>Where each zone lands, as pixel columns (left edge to right edge, width)</caption>
      <thead>
        <tr>
          <th scope="col">Monitor</th>
          {priorityZones.map((z) => <th scope="col">Zone {z.id} ({fraction(z.x, z.w)})</th>)}
        </tr>
      </thead>
      <tbody>
        {
          exampleMonitors.map((m) => {
            const s = spans(m.width);
            return (
              <tr>
                <th scope="row">{m.name}</th>
                {s.map((p) => (
                  <td>
                    {fmt(p.left)} &ndash; {fmt(p.right)} <span class="muted">({fmt(p.width)})</span>
                  </td>
                ))}
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <figcaption>
    Zones are stored as fractions of the monitor, not as pixels, so one layout fits any screen. Each edge is rounded on
    its own and neighbouring zones share an edge exactly, so they tile with no gaps.
    {
      showRounding && (
        <Fragment>
          {' '}
          On the {laptop.name} laptop, {l25} and {fmt(l75)} fall on half pixels and round to {fmt(laptopSpans[0].right)} and{' '}
          {fmt(laptopSpans[1].right)}, giving widths of {laptopSpans.map((p) => fmt(p.width)).join(', ')} px.
        </Fragment>
      )
    }
    The real app maps zones onto the monitor&rsquo;s work area, which excludes the taskbar; the table uses the full width.
  </figcaption>
</figure>

<style>
  .fr {
    display: grid;
    gap: var(--space-l);
  }

  .monitors {
    display: grid;
    gap: var(--space-l);
  }

  .mon-name {
    margin-bottom: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .mono {
    font-family: var(--font-mono);
  }

  svg {
    width: 100%;
    height: auto;
  }
  .bezel {
    fill: var(--ill-wall);
    stroke: var(--color-border-strong);
    stroke-width: 1;
  }
  .zone {
    fill: var(--ill-zone-fill);
    stroke: var(--ill-zone-stroke);
    stroke-width: 0.8;
  }
  .zone.mid {
    fill: var(--ill-hi-fill);
    stroke: var(--ill-hi-stroke);
  }
  .n {
    fill: var(--color-text);
    font: 700 10px var(--font-sans);
    text-anchor: middle;
  }

  .cols {
    display: grid;
    grid-template-columns: 25fr 50fr 25fr;
    margin-top: var(--space-2xs);
    padding-inline: 1.9%;
    text-align: center;
    font-size: var(--text-xs);
    line-height: 1.35;
  }
  .col {
    display: grid;
    padding-inline: 2px;
  }
  .frac {
    color: var(--color-text-soft);
  }
  .px {
    font-weight: 650;
    color: var(--color-text);
  }

  figcaption {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .data-table th[scope='row'] {
    white-space: nowrap;
    font-weight: 600;
  }
  .data-table td {
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .monitors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
