---
import Glyph from './Glyph.astro';
import Icon from './Icon.astro';
import { statusLabel } from '../data/roadmap';
import type { RoadmapItem } from '../data/roadmap';

interface Props {
  item: RoadmapItem;
}

const { item } = Astro.props;
---

<li class="item">
  <div class="top">
    <div class="art"><Glyph name={item.glyph} /></div>
    <p class={`status status--${item.status}`}>
      {item.status === 'available' && <Icon name="check" />}
      {item.status === 'progress' && <span class="dot" aria-hidden="true" />}
      {statusLabel[item.status]}
    </p>
  </div>
  <h3>
    {item.name}
    {item.tag && <span class="tag">{item.tag}</span>}
  </h3>
  <p class="text">{item.text}</p>
</li>

<style>
  .item {
    display: flex;
    flex-direction: column;
    padding: var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-s);
  }
  .art {
    display: grid;
    place-items: center;
    width: 6.25rem;
    height: 4.25rem;
    border-radius: var(--radius-m);
    background: var(--color-surface-2);
  }

  h3 {
    font-size: var(--text-md);
  }
  .tag {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
    vertical-align: 0.1em;
    white-space: nowrap;
  }
  .text {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>
