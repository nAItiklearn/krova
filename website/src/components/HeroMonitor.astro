---
/**
 * Hero illustration: a monitor split into thirds. A window is dragged across,
 * the zone under it lights up, and on release the window fills the right-hand
 * zone. Pure SVG + CSS, no JavaScript, no raster images. It is an
 * illustration, not a screenshot, and is labelled as such.
 *
 * Motion is only applied when the user has not asked for reduced motion; the
 * resting (static) state shows the snapped result. A CSS-only checkbox lets
 * anyone pause the loop (WCAG 2.2.2).
 */
---

<figure class="hero-visual">
  <svg
    class="monitor"
    viewBox="0 0 640 410"
    width="640"
    height="410"
    role="img"
    aria-labelledby="hm-title hm-desc"
  >
    <title id="hm-title">Illustration: a monitor divided into three zones</title>
    <desc id="hm-desc">
      A window is dragged across a monitor that is split into three vertical zones. The zone under the window lights
      up, and when the window is released over the right-hand zone it fills that zone.
    </desc>

    <!-- stand -->
    <path class="stand" d="M288 372h64l8 24h-80z"></path>
    <rect class="stand" x="236" y="394" width="168" height="10" rx="5"></rect>

    <!-- monitor -->
    <rect class="bezel" width="640" height="372" rx="24"></rect>
    <rect class="screen" x="14" y="14" width="612" height="344" rx="12"></rect>

    <!-- the three zones -->
    <rect class="zone" x="28" y="28" width="188" height="316" rx="10"></rect>
    <rect class="zone" x="226" y="28" width="188" height="316" rx="10"></rect>
    <rect class="zone" x="424" y="28" width="188" height="316" rx="10"></rect>

    <!-- highlight overlays: the one under the window is lit -->
    <rect class="hi hi-1" x="28" y="28" width="188" height="316" rx="10"></rect>
    <rect class="hi hi-2" x="226" y="28" width="188" height="316" rx="10"></rect>
    <rect class="hi hi-3" x="424" y="28" width="188" height="316" rx="10"></rect>

    <!-- the window: drawn at its final size inside the right-hand zone -->
    <g class="win">
      <rect class="win-body" x="424" y="28" width="188" height="316" rx="10"></rect>
      <path class="win-bar" d="M424 58V38a10 10 0 0 1 10-10H602a10 10 0 0 1 10 10V58z"></path>
      <circle class="win-dot" cx="440" cy="43" r="4"></circle>
      <circle class="win-dot" cx="453" cy="43" r="4"></circle>
      <circle class="win-dot" cx="466" cy="43" r="4"></circle>
      <rect class="win-line" x="440" y="78" width="110" height="10" rx="5"></rect>
      <rect class="win-line" x="440" y="100" width="156" height="7" rx="3.5"></rect>
      <rect class="win-line" x="440" y="114" width="140" height="7" rx="3.5"></rect>
      <rect class="win-line" x="440" y="128" width="150" height="7" rx="3.5"></rect>
      <rect class="win-block" x="440" y="156" width="156" height="96" rx="8"></rect>
      <rect class="win-line" x="440" y="268" width="100" height="8" rx="4"></rect>
      <rect class="win-line" x="440" y="284" width="130" height="8" rx="4"></rect>
      <path class="cursor" d="M0 0v17l4.4-4 3.1 7.2 2.6-1.1-3.1-7.1H14z" transform="translate(542 36)"></path>
    </g>
  </svg>

  <figcaption>
    <span class="cap-text"><kbd>Shift</kbd> held while dragging, zones appear, release to snap. Illustration, not a screenshot.</span>
    <label class="pause"><input type="checkbox" class="pause-box" /> Pause animation</label>
  </figcaption>
</figure>

<style>
  .hero-visual {
    width: 100%;
  }

  .monitor {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 24px 40px rgba(30, 30, 110, 0.22));
  }

  .bezel {
    fill: var(--mon-bezel);
  }
  .screen {
    fill: var(--mon-screen);
  }
  .stand {
    fill: var(--mon-stand);
  }

  .zone {
    fill: var(--zone-fill);
    stroke: var(--zone-stroke);
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
  }

  .hi {
    fill: var(--zone-hi-fill);
    stroke: var(--zone-hi-stroke);
    stroke-width: 2.5;
    opacity: 0;
  }
  /* Resting state: right-hand zone lit, window snapped into it. */
  .hi-3 {
    opacity: 1;
  }

  .win {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
  .win-body {
    fill: var(--win-bg);
    stroke: var(--win-stroke);
    stroke-width: 1.5;
  }
  .win-bar {
    fill: var(--win-bar);
  }
  .win-dot,
  .win-line {
    fill: var(--win-line);
  }
  .win-block {
    fill: var(--win-block);
  }
  .cursor {
    fill: var(--cursor-fill);
    stroke: var(--cursor-stroke);
    stroke-width: 1.5;
    stroke-linejoin: round;
    opacity: 0;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-s);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pause {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    cursor: pointer;
  }

  .pause-box {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--color-accent);
  }

  /* No motion requested: nothing animates, so there is nothing to pause. */
  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The negative delay starts the loop mid-cycle (window already over the
       first zone) so the very first paint is never an empty monitor. */
    .win {
      animation: win-drag 11s ease-in-out -1.5s infinite;
    }
    .cursor {
      animation: cursor-show 11s linear -1.5s infinite;
    }
    .hi-1 {
      animation: hi-1 11s linear -1.5s infinite;
    }
    .hi-2 {
      animation: hi-2 11s linear -1.5s infinite;
    }
    .hi-3 {
      animation: hi-3 11s linear -1.5s infinite;
    }

    /* Pause control: checking the box freezes every animation in the figure. */
    .hero-visual:has(.pause-box:checked) .win,
    .hero-visual:has(.pause-box:checked) .cursor,
    .hero-visual:has(.pause-box:checked) .hi {
      animation-play-state: paused;
    }
  }

  @keyframes win-drag {
    0% {
      transform: translate(-396px, 24px) scale(0.8) rotate(-2deg);
      opacity: 0;
    }
    5%,
    20% {
      transform: translate(-396px, 24px) scale(0.8) rotate(-2deg);
      opacity: 1;
    }
    40%,
    48% {
      transform: translate(-198px, 36px) scale(0.8) rotate(1.5deg);
      opacity: 1;
    }
    62%,
    70% {
      transform: translate(0, 24px) scale(0.8) rotate(-1deg);
      opacity: 1;
    }
    78%,
    93% {
      transform: translate(0, 0) scale(1) rotate(0deg);
      opacity: 1;
    }
    98% {
      transform: translate(0, 0) scale(1) rotate(0deg);
      opacity: 0;
    }
    100% {
      transform: translate(-396px, 24px) scale(0.8) rotate(-2deg);
      opacity: 0;
    }
  }

  @keyframes cursor-show {
    0% {
      opacity: 0;
    }
    6%,
    70% {
      opacity: 1;
    }
    76%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hi-1 {
    0% {
      opacity: 0;
    }
    5%,
    24% {
      opacity: 1;
    }
    30%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hi-2 {
    0%,
    34% {
      opacity: 0;
    }
    40%,
    52% {
      opacity: 1;
    }
    58%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hi-3 {
    0%,
    56% {
      opacity: 0;
    }
    62%,
    94% {
      opacity: 1;
    }
    99%,
    100% {
      opacity: 0;
    }
  }
</style>
