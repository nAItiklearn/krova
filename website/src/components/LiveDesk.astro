  .w {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    border-radius: 0.9cqw;
    background: #fff;
    overflow: hidden;
    box-shadow:
      0 0 0 0.08cqw rgba(0, 0, 0, 0.14),
      0 1.6cqw 3.4cqw -0.8cqw rgba(30, 20, 10, 0.35);
    will-change: transform, width, height, opacity;
    opacity: 0;
    font-size: 1.05cqw;
    color: #1b1b1a;
    transition: box-shadow 0.3s ease;
  }
  /* Highlight styles (set by the Customise panel): none, active border, all borders, glow. */
  .hl-active .w:global(.focus),
  .hl-all .w {
    box-shadow:
      0 0 0 0.16cqw var(--hl),
      0 1.8cqw 3.8cqw -0.8cqw rgba(30, 20, 10, 0.4);
