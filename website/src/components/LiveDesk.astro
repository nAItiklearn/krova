---
/**
 * The hero's live desktop: a laptop whose lid opens, with a small Windows desktop inside where
 * windows arrange themselves into zones. Plays a short sequence, then hands control to the visitor
 * (layout buttons, open and close a window). Pure HTML/CSS plus one inline module, no images.
 * The windows and their contents are drawn placeholders for real apps, not Krova's own UI.
 */
interface Props {
  id?: string;
  /** "story" plays the opening sequence; "static" starts with three windows already arranged. */
  mode?: 'story' | 'static';
  /** Show the layout and open/close buttons under the laptop. */
  controls?: boolean;
  label?: string;
}
const { id = 'live', mode = 'story', controls = true, label = 'Live demo: windows arranging themselves' } = Astro.props;
const apps = [
  { key: 'web', title: 'Field notes — Browser' },
  { key: 'notes', title: 'Notes' },
  { key: 'term', title: 'Terminal' },
  { key: 'mail', title: 'Mail' },
];
---

<section class="desk-wrap hl-active" id={id} data-mode={mode} data-gap="0.9" aria-label={label}>
  <div class="laptop">
    <div class="lid">
      <div class="screen" data-screen>
        <div class="wall" aria-hidden="true"></div>
        <div class="zones" data-zones aria-hidden="true"></div>

        {
          apps.map((a) => (
            <div class="w" data-win={a.key} aria-hidden="true">
              <div class="bar">
                <span class={`ico ico-${a.key}`} />
                <span class="t">{a.title}</span>
                <span class="ctl">
                  <i />
                  <i />
                  <i />
                </span>
              </div>
              <div class={`body body-${a.key}`}>
                {a.key === 'web' && (
                  <Fragment>
                    <div class="url">fieldnotes.example/lisbon-in-spring</div>
                    <div class="kicker">TRAVEL · 6 MIN READ</div>
                    <div class="h">Lisbon in spring, slowly</div>
                    <div class="hero-img" />
                    <div class="ln" />
                    <div class="ln" />
                    <div class="ln s" />
                  </Fragment>
                )}
                {a.key === 'notes' && (
                  <Fragment>
                    <div class="h">Release checklist</div>
                    <div class="todo done">Record the demo</div>
                    <div class="todo done">Write the changelog</div>
                    <div class="todo">Test two monitors</div>
                    <div class="todo">Ship 0.2</div>
                  </Fragment>
                )}
                {a.key === 'term' && (
                  <Fragment>
                    <div>
                      <b>~/krova</b> $ cargo test
                    </div>
                    <div class="dim">   Compiling krova-core v0.2.0</div>
                    <div class="dim">    Finished test in 4.1s</div>
                    <div class="ok">test result: ok. 350 passed</div>
                    <div>
                      <b>~/krova</b> $ <span class="caret" />
                    </div>
                  </Fragment>
                )}
                {a.key === 'mail' && (
                  <Fragment>
                    <div class="mrow">
                      <span class="av" />
                      <span class="ml" />
                    </div>
                    <div class="mrow">
                      <span class="av a2" />
                      <span class="ml" />
                    </div>
                    <div class="mrow">
                      <span class="av a3" />
                      <span class="ml" />
                    </div>
                  </Fragment>
                )}
              </div>
            </div>
          ))
        }

        <div class="toast" data-toast aria-hidden="true"><span class="mk"></span> <span data-toast-text>Auto-arrange on</span></div>

        <div class="taskbar" aria-hidden="true">
          <div class="tb-apps">
            <span class="tb-start"><i></i><i></i><i></i><i></i></span>
            <span class="tb-search">Search</span>
            {apps.map((a) => <span class={`tb-app ico-${a.key}`} data-tb={a.key} />)}
          </div>
          <div class="tb-tray">
            <span class="tb-krova" data-tray><i></i><i></i><i></i></span>
            <span class="tb-time">9:41</span>
          </div>
        </div>
      </div>
    </div>
    <div class="base" aria-hidden="true"><span class="notch"></span></div>
  </div>

  {controls && (<Fragment>
  <div class="controls" role="group" aria-label="Try it">
    <div class="seg" role="radiogroup" aria-label="Layout">
      <button type="button" role="radio" aria-checked="true" data-layout="side">Main + side</button>
      <button type="button" role="radio" aria-checked="false" data-layout="columns">Columns</button>
      <button type="button" role="radio" aria-checked="false" data-layout="grid">Grid</button>
    </div>
    <div class="acts">
      <button type="button" class="pillbtn" data-open>Open a window</button>
      <button type="button" class="pillbtn" data-close>Close one</button>
    </div>
  </div>
  <p class="cap visually-hidden" data-cap aria-live="polite">Open a window and Krova gives it a zone. Close one and the rest fill in.</p>
  </Fragment>)}
</section>

<style>
  .desk-wrap {
    --hl: #ff5b1f;
    max-width: 64rem;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  /* ---- Laptop ---- */
  .laptop {
    perspective: 2400px;
  }
  .lid {
    position: relative;
    margin: 0 auto;
    width: 88%;
    padding: 1.1% 1.1% 1.4%;
    border-radius: 18px 18px 6px 6px;
    background: linear-gradient(180deg, #2a2a2c, #161617);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 40px 80px -30px rgba(40, 20, 10, 0.45);
    transform-origin: 50% 100%;
    animation: lid-open 1.6s cubic-bezier(0.2, 0.75, 0.2, 1) 0.25s backwards;
  }
  @keyframes lid-open {
    from {
      transform: rotateX(-84deg);
    }
    to {
      transform: rotateX(0);
    }
  }
  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    container-type: inline-size;
    background: #000;
    font-family: 'Segoe UI Variable Text', 'Segoe UI', var(--font-sans);
  }
  .screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
    animation: wake 0.9s ease-out 1.25s both;
    z-index: 50;
  }
  @keyframes wake {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  .base {
    position: relative;
    height: clamp(10px, 1.6vw, 18px);
    margin: 0 auto;
    width: 100%;
    border-radius: 2px 2px 14px 14px;
    background: linear-gradient(180deg, #d6d4d0 0%, #a9a7a3 60%, #8a8884 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 18px 30px -16px rgba(40, 20, 10, 0.5);
  }
  .notch {
    position: absolute;
    left: 50%;
    top: 0;
    width: 14%;
    height: 38%;
    transform: translateX(-50%);
    border-radius: 0 0 8px 8px;
    background: rgba(0, 0, 0, 0.14);
  }

  /* ---- Desktop ---- */
  .wall {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 18% 8%, #ffb48a 0%, transparent 60%),
      radial-gradient(60% 70% at 92% 96%, #c7b6f2 0%, transparent 62%),
      radial-gradient(50% 50% at 60% 40%, #ffe3cf 0%, transparent 70%),
      linear-gradient(150deg, #f7d9c4, #efe4ef 55%, #dcd3f1);
  }
  .zones :global(.z) {
    position: absolute;
    border-radius: 1.1cqw;
    border: 0.18cqw dashed rgba(20, 20, 19, 0.3);
    background: rgba(255, 255, 255, 0.2);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .zones:global(.show) :global(.z) {
    opacity: 1;
  }
  .zones :global(.z.hit) {
    border-style: solid;
    border-color: #ff5b1f;
