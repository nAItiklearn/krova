  }
  .seg button:focus-visible,
  .pillbtn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .cap {
    margin-top: 0.9rem;
    text-align: center;
    color: var(--color-text-soft);
    font-size: var(--text-sm);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .base {
      background: linear-gradient(180deg, #3a3a3c 0%, #262628 60%, #1a1a1b 100%);
    }
  }
  :global(:root[data-theme='dark']) .base {
    background: linear-gradient(180deg, #3a3a3c 0%, #262628 60%, #1a1a1b 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .lid,
    .screen::after {
      animation: none;
    }
    .screen::after {
      opacity: 0;
    }
  }
</style>

<script>
  // Damped spring with fixed substeps (the same model as the app's layout switcher prototype).
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
  class Spring {
    value: number;
    target: number;
    vel = 0;
    k: number;
    c: number;
    constructor(v: number, k = 230, zeta = 0.82) {
      this.value = this.target = v;
      this.k = k;
      this.c = 2 * Math.sqrt(k) * zeta;
    }
    set(t: number) {
      this.target = t;
      if (REDUCED) this.jump(t);
    }
    jump(v: number) {
      this.value = this.target = v;
      this.vel = 0;
    }
    step(dt: number) {
      const h = 1 / 240;
      for (let t = 0; t < dt; t += h) {
        const a = -this.k * (this.value - this.target) - this.c * this.vel;
        this.vel += a * h;
        this.value += this.vel * h;
      }
    }
    get settled() {
      return Math.abs(this.value - this.target) < 0.01 && Math.abs(this.vel) < 0.02;
    }
  }

  type Rect = [number, number, number, number]; // x, y, w, h in % of the work area
  type LayoutKind = 'side' | 'columns' | 'grid';

  const AREA_H = 92; // the work area: the screen minus the taskbar, in % of its height


  function zonesFor(kind: LayoutKind, n: number): Rect[] {
    if (n <= 1) return [[0, 0, 100, 100]];
    if (kind === 'columns') return Array.from({ length: n }, (_, i) => [(i * 100) / n, 0, 100 / n, 100] as Rect);
    if (kind === 'grid') {
      if (n === 2) return [[0, 0, 50, 100], [50, 0, 50, 100]];
      if (n === 3) return [[0, 0, 50, 50], [50, 0, 50, 50], [0, 50, 100, 50]];
      return [[0, 0, 50, 50], [50, 0, 50, 50], [0, 50, 50, 50], [50, 50, 50, 50]];
    }
    const side = n - 1;
    return [[0, 0, 60, 100] as Rect].concat(
      Array.from({ length: side }, (_, i) => [60, (i * 100) / side, 40, 100 / side] as Rect),
    );
  }

  function init(root: HTMLElement) {
    const screen = root.querySelector<HTMLElement>('[data-screen]')!;
    const zonesEl = root.querySelector<HTMLElement>('[data-zones]')!;
    const toast = root.querySelector<HTMLElement>('[data-toast]')!;
    const toastText = root.querySelector<HTMLElement>('[data-toast-text]')!;
    const tray = root.querySelector<HTMLElement>('[data-tray]')!;
    const cap = root.querySelector<HTMLElement>('[data-cap]');
    const segBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-layout]')];
    const openBtn = root.querySelector<HTMLButtonElement>('[data-open]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-close]');
    let G = parseFloat(root.dataset.gap ?? '0.9');

    const order = ['web', 'notes', 'term', 'mail'];
    const names: Record<string, string> = { web: 'the browser', notes: 'Notes', term: 'the terminal', mail: 'Mail' };
    const wins = new Map(
      order.map((k) => [
        k,
        {
          el: root.querySelector<HTMLElement>(`[data-win="${k}"]`)!,
          tb: root.querySelector<HTMLElement>(`[data-tb="${k}"]`)!,
          x: new Spring(32),
          y: new Spring(26),
          w: new Spring(36),
          h: new Spring(40),
          a: new Spring(0, 260, 1),
          s: new Spring(0.92, 260, 0.75),
        },
      ]),
    );
    let open: string[] = [];
    let kind: LayoutKind = 'side';
    let focusKey: string | null = null;

    function inset(rect: Rect): Rect {
      const [x, y, w, h] = rect;
      return [x + G / 2, (y * AREA_H) / 100 + G / 2, w - G, (h * AREA_H) / 100 - G];
    }
    function drawZones(n: number) {
      zonesEl.innerHTML = '';
      zonesFor(kind, Math.max(1, n)).forEach((r) => {
        const z = document.createElement('div');
        z.className = 'z';
        const [x, y, w, h] = inset(r);
        Object.assign(z.style, { left: x + '%', top: y + '%', width: w + '%', height: h + '%' });
        zonesEl.appendChild(z);
      });
    }
    function flashZones(ms: number, hit = -1) {
      zonesEl.classList.add('show');
      if (hit >= 0) (zonesEl.children[hit] as HTMLElement | undefined)?.classList.add('hit');
      setTimeout(() => zonesEl.classList.remove('show'), ms);
    }
    function layout() {
      const zs = zonesFor(kind, open.length);
      open.forEach((k, i) => {
        const [x, y, w, h] = inset(zs[i]);
        const s = wins.get(k)!;
        s.x.set(x);
        s.y.set(y);
        s.w.set(w);
        s.h.set(h);
      });
      kick();
    }
    function setFocus(k: string | null) {
      focusKey = k;
      wins.forEach((s, key) => s.el.classList.toggle('focus', key === k));
    }

    let toastTimer = 0;
    function say(text: string) {
      toastText.textContent = text;
      toast.classList.add('on');
      tray.classList.add('ping');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('on');
        tray.classList.remove('ping');
      }, 1700);
    }

    function openWin(k: string) {
      const s = wins.get(k)!;
      s.x.jump(32);
      s.y.jump(24);
      s.w.jump(36);
      s.h.jump(42);
      s.a.jump(0);
      s.s.jump(0.9);
      s.a.set(1);
      s.s.set(1);
      s.el.style.zIndex = String(10 + open.length);
      open.push(k);
      s.tb.classList.add('run', 'pop');
      setTimeout(() => s.tb.classList.remove('pop'), 260);
      drawZones(open.length);
      flashZones(700, open.length - 1);
      kick();
      setTimeout(layout, REDUCED ? 0 : 180);
      setFocus(k);
      sync();
    }
    function closeWin(k: string) {
      const s = wins.get(k)!;
      s.a.set(0);
      s.s.set(0.94);
      open = open.filter((o) => o !== k);
      s.tb.classList.remove('run');
      setFocus(open[open.length - 1] ?? null);
      kick();
      setTimeout(layout, REDUCED ? 0 : 140);
      sync();
    }
    function setKind(next: LayoutKind) {
      kind = next;
      segBtns.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.layout === next)));
      drawZones(open.length);
      flashZones(550);
      layout();
      say(next === 'side' ? 'Main + side' : next === 'columns' ? 'Columns' : 'Grid');
    }
    function sync() {
      if (openBtn) openBtn.disabled = open.length >= order.length;
      if (closeBtn) closeBtn.disabled = open.length === 0;
    }
    // The Customise panel talks to the desk through events on its root.
    root.addEventListener('krova:gap', (e) => {
      G = (e as CustomEvent<number>).detail;
      drawZones(open.length);
      layout();
    });
    root.addEventListener('krova:layout', (e) => setKind((e as CustomEvent<LayoutKind>).detail));

    // Render loop: runs only while a spring is moving.
    let raf = 0;
    let last = 0;
    function kick() {
      if (!raf) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    }
    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      let moving = false;
      const W = screen.clientWidth;
      const H = screen.clientHeight;
      wins.forEach((s) => {
        for (const sp of [s.x, s.y, s.w, s.h, s.a, s.s]) {
          sp.step(dt);
          moving ||= !sp.settled;
        }
        s.el.style.width = (s.w.value * W) / 100 + 'px';
        s.el.style.height = (s.h.value * H) / 100 + 'px';
        s.el.style.transform = `translate3d(${(s.x.value * W) / 100}px, ${(s.y.value * H) / 100}px, 0) scale(${s.s.value})`;
        s.el.style.opacity = String(Math.max(0, Math.min(1, s.a.value)));
      });
      raf = moving ? requestAnimationFrame(frame) : 0;
    }
    new ResizeObserver(kick).observe(screen);

    // Any visitor input stops the autoplay.
    let auto = true;
    const takeOver = () => {
      auto = false;
    };
    segBtns.forEach((b) =>
      b.addEventListener('click', () => {
        takeOver();
        setKind(b.dataset.layout as LayoutKind);
      }),
    );
    root.querySelector('.seg')?.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key !== 'ArrowRight' && ke.key !== 'ArrowLeft') return;
      ke.preventDefault();
      const i = segBtns.findIndex((b) => b.getAttribute('aria-checked') === 'true');
      const n = segBtns[(i + (ke.key === 'ArrowRight' ? 1 : segBtns.length - 1)) % segBtns.length];
      n.focus();
      n.click();
    });
    openBtn?.addEventListener('click', () => {
      takeOver();
      const k = order.find((o) => !open.includes(o));
      if (k) {
        openWin(k);
        if (cap) cap.textContent = `Opened ${names[k]}. It went to the next free zone.`;
      }
    });
    closeBtn?.addEventListener('click', () => {
      takeOver();
      const k = focusKey ?? open[open.length - 1];
      if (k) {
        closeWin(k);
        if (cap) cap.textContent = 'Closed a window. The others filled the space.';
      }
    });
    screen.addEventListener('pointerdown', (e) => {
      const w = (e.target as HTMLElement).closest<HTMLElement>('[data-win]');
      if (w) {
        takeOver();
        setFocus(w.dataset.win!);
      }
    });

    // Autoplay: a short story, then it is the visitor's turn.
    const wait = (ms: number) => new Promise((r) => setTimeout(r, REDUCED ? Math.min(ms, 200) : ms));
    async function story() {
      await wait(2300); // the lid opens and the screen wakes
      if (!auto) return;
      say('Auto-arrange on');
      for (const k of ['web', 'notes', 'term']) {
        await wait(900);
        if (!auto) return;
        openWin(k);
      }
      await wait(1900);
      if (!auto) return;
      setKind('columns');
      await wait(2000);
      if (!auto) return;
      closeWin('notes');
      await wait(1700);
      if (!auto) return;
      openWin('notes');
      await wait(1800);
      if (!auto) return;
      setKind('side');
    }
    sync();
    if (root.dataset.mode === 'static') {
      // already arranged: no zone flashes, no toast
      ['web', 'notes', 'term'].forEach((k) => {
        const s = wins.get(k)!;
        s.a.jump(1);
        s.s.jump(1);
        s.el.style.zIndex = String(10 + open.length);
        s.tb.classList.add('run');
        open.push(k);
      });
      setFocus('web');
      const zs = zonesFor(kind, open.length);
      open.forEach((k, i) => {
        const [x, y, w, h] = inset(zs[i]);
        const s = wins.get(k)!;
        s.x.jump(x); s.y.jump(y); s.w.jump(w); s.h.jump(h);
      });
      kick();
      sync();
      return;
    }
    const io = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) {
          io.disconnect();
          story();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('.desk-wrap').forEach(init);
</script>
