  }
  .todo {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.45cqw 0;
    font-size: 1.05cqw;
    white-space: nowrap;
  }
  .todo::before {
    content: '';
    width: 1cqw;
    height: 1cqw;
    border-radius: 50%;
    border: 0.12cqw solid #b9b4aa;
