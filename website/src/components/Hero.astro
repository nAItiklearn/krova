---
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import WindowFrame from './WindowFrame.astro';
import { url } from '../lib/url';
import { MAC_RELEASED, RELEASE_PUBLISHED, VERSION_LABEL } from '../site';

const status = RELEASE_PUBLISHED ? `${VERSION_LABEL}, early preview` : `${VERSION_LABEL}, not released yet`;
const platforms = MAC_RELEASED ? 'Windows 10/11 and macOS 13+' : 'Windows 10/11';
const buttonLabel = MAC_RELEASED ? 'Download' : 'Download for Windows';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="copy">
      <p class="status">
        <a class="pill pill--warn" href={url('/changelog/')}>
          <span class="dot" aria-hidden="true"></span>{status}
          <span class="more">What is in it <Icon name="arrow" /></span>
        </a>
      </p>

      <h1 id="hero-title">
        Draw your zones.
        <span class="soft line">Hold Shift, drop a window in.</span>
      </h1>

      <p class="lead">
        A free, offline window zone manager for {MAC_RELEASED ? 'Windows and macOS' : 'Windows'}. No account, no telemetry, no
        network calls.
      </p>

      <div class="actions">
        <a class="btn btn-primary" href={url('/download/')}>
          <Icon name="download" />
          {buttonLabel}
        </a>
        <a class="btn btn-secondary" href={url('/demo/')}>
          Try it in the browser
          <Icon name="arrow" />
        </a>
      </div>
      <p class="fine">
        Free &middot; MIT license &middot; {platforms}{!MAC_RELEASED && <Fragment> &middot; macOS once it has been tested on a real Mac</Fragment>}
      </p>
    </div>

    <figure class="stage">
      <div>
        <WindowFrame closed={false}>
          <Shot
            name="editor"
            alt="Krova's layout editor on a sample monitor. The Priority layout has three zones; the wide middle one is selected. On the right: the layout name, the list of layouts on this monitor, templates, and export and import."
          />
        </WindowFrame>
      </div>
      <figcaption class="visually-hidden">Screenshot of Krova's editor, shown with two sample monitors.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1rem + 5vw, 5rem) clamp(2.5rem, 1rem + 4vw, 4.5rem);
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .status {
    margin-bottom: var(--space-l);
  }
  .status a {
    text-decoration: none;
  }
  .status .more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.35rem;
    padding-left: 0.7rem;
    border-left: 1px solid var(--color-warn-border);
    color: var(--color-link);
  }
  .status .more :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
  }

  h1 {
    font-size: clamp(2.35rem, 0.9rem + 5.2vw, 4.25rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  h1 .line {
    display: block;
  }

  .lead {
    margin-top: var(--space-m);
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .fine {
    margin-top: var(--space-s);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  /* The desktop behind the window: one flat neutral surface. The window runs off its bottom edge. */
  .stage {
    max-width: 66rem;
    margin: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) auto 0;
    padding: clamp(0.6rem, 0.2rem + 3vw, 2.75rem) clamp(0.6rem, 0.2rem + 3.5vw, 3.5rem) 0;
    max-height: clamp(18rem, 6rem + 52vw, 41rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--stage-bg);
  }
</style>
