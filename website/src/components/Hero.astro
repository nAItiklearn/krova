---
import Icon from './Icon.astro';
import LiveDesk from './LiveDesk.astro';
import { url } from '../lib/url';
import { MAC_RELEASED } from '../site';

const platforms = MAC_RELEASED ? 'Windows 10/11 and macOS 13+' : 'Windows 10 and 11';
const buttonLabel = MAC_RELEASED ? 'Download' : 'Download for Windows';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="bg" aria-hidden="true"></div>
  <div class="container copy">
    <a class="news rise" style="--d: 0.05s" href={url('/roadmap/')}>
      <span class="tag">New</span>
      <span>Auto-arrange and the layout switcher are coming in 0.2</span>
      <Icon name="arrow" />
    </a>

    <h1 id="hero-title">
      <span class="l1">
        <span class="hw" style="--d: 0.12s">Every</span>
        <span class="hw" style="--d: 0.2s">window,</span>
        <span class="chip" style="--d: 0.55s" aria-hidden="true"><span class="t t1"></span><span class="t t2"></span><span class="t t3"></span></span>
      </span>
      <span class="l2">
        <span class="hw soft" style="--d: 0.3s">in</span>
        <span class="hw soft" style="--d: 0.36s">its</span>
        <span class="hw" style="--d: 0.44s">place.</span>
      </span>
    </h1>

    <p class="lead rise" style="--d: 0.6s">
      Draw your zones, or let Krova arrange windows as they open.
    </p>

    <div class="actions rise" style="--d: 0.72s">
      <a class="cta" href={url('/download/')}>
        {buttonLabel}
        <span class="cta-arrow"><Icon name="arrow" /></span>
      </a>
      <a class="ghost" href="#live">Try it live <Icon name="chevron" /></a>
    </div>
    <p class="fine rise" style="--d: 0.8s">Free and open source <span>·</span> {platforms}</p>
  </div>

  <div class="desk rise-late">
    <LiveDesk />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 1.5rem + 5vw, 5.5rem) clamp(3rem, 2rem + 4vw, 6rem);
    isolation: isolate;
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 95%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 95%);
    background:
      radial-gradient(50% 60% at 20% 70%, rgba(255, 140, 90, 0.16), transparent 70%),
      radial-gradient(40% 50% at 85% 75%, rgba(170, 150, 240, 0.14), transparent 70%);
    pointer-events: none;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .news {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.32rem 0.9rem 0.32rem 0.35rem;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px var(--color-border),
      0 1px 2px rgba(0, 0, 0, 0.04);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: box-shadow 0.2s;
  }
  .news:hover {
    box-shadow:
      0 0 0 1px var(--color-border-strong),
      0 1px 2px rgba(0, 0, 0, 0.04);
    text-decoration: none;
  }
  .news .tag {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-tint-strong);
    color: var(--color-accent-text);
    font-weight: 650;
  }
  .news :global(.icon) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--color-text-soft);
  }

  h1 {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    font-size: clamp(3rem, 1rem + 7.4vw, 6.4rem);
    font-weight: 750;
    letter-spacing: -0.052em;
    line-height: 0.98;
  }
  h1 .l1,
  h1 .l2 {
    display: block;
    white-space: nowrap;
  }
  .hw {
    display: inline-block;
    animation: hw 0.9s var(--d, 0s) cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .hw.soft {
    color: var(--color-text-soft);
  }
  @keyframes hw {
    from {
      opacity: 0;
      filter: blur(14px);
      transform: translateY(0.25em);
    }
  }

  /* The zone chip: Krova's mark as a small key in the headline. */
  .chip {
    position: relative;
    display: inline-block;
    width: 1.02em;
    height: 0.8em;
    margin-left: 0.14em;
    vertical-align: -0.03em;
    border-radius: 0.2em;
    background: var(--color-surface);
    box-shadow:
      inset 0 0.02em 0 rgba(255, 255, 255, 0.9),
      0 0 0 0.012em var(--color-border),
      0 0.14em 0.32em -0.08em rgba(60, 30, 10, 0.35);
    transform: rotate(-6deg);
    animation: chip 1s var(--d, 0s) cubic-bezier(0.2, 0.9, 0.25, 1.2) both;
  }
  .chip .t {
    position: absolute;
    display: block;
    border-radius: 0.07em;
    background: var(--color-text);
  }
  .chip .t1 {
    left: 0.1em;
    top: 0.1em;
    width: 0.44em;
    bottom: 0.1em;
    background: var(--color-ember);
  }
  .chip .t2 {
    left: 0.6em;
    right: 0.1em;
    top: 0.1em;
    height: 0.27em;
  }
  .chip .t3 {
    left: 0.6em;
    right: 0.1em;
    bottom: 0.1em;
    height: 0.27em;
  }
  @keyframes chip {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: scale(0.3) rotate(-30deg);
    }
  }

  .lead {
    margin-top: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    max-width: 36rem;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.42rem 0.42rem 0.42rem 1.4rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 10px 24px -10px rgba(20, 20, 19, 0.55);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.2s;
  }
  .cta:hover {
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 14px 30px -10px rgba(20, 20, 19, 0.6);
  }
  .cta-arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-on-accent);
    color: var(--color-accent);
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cta:hover .cta-arrow {
    transform: translateX(2px);
  }
  .cta-arrow :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 1.25rem;
    min-height: 3.05rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 550;
    text-decoration: none;
    box-shadow: 0 0 0 1px var(--color-border);
    transition: box-shadow 0.2s;
  }
  .ghost:hover {
    text-decoration: none;
    box-shadow: 0 0 0 1px var(--color-border-strong);
  }
  .ghost :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .fine {
    margin-top: 1.1rem;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }
  .fine span {
    margin-inline: 0.3rem;
    opacity: 0.6;
  }

  .desk {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .rise {
    animation: rise 0.8s var(--d, 0s) cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .rise-late {
    animation: rise 1.1s 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(14px);
    }
  }

  @media (max-width: 40rem) {
    h1 .l1,
    h1 .l2 {
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hw,
    .chip,
    .rise,
    .rise-late {
      animation: none;
    }
  }
</style>
