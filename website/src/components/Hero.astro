---
import HeroMonitor from './HeroMonitor.astro';
import Icon from './Icon.astro';
import { VERSION_LABEL } from '../site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <p class="badge"><span class="dot" aria-hidden="true"></span>Early software: {VERSION_LABEL}, not yet released</p>
      <h1 id="hero-title">Snap windows into <span class="grad-text">zones you define</span>.</h1>
      <p class="lead">
        Krova is a free, open-source window zone manager for Windows and macOS. Hold <kbd>Shift</kbd>, drag a
        window, release over a zone. Everything stays on your computer.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#download">
          <Icon name="download" />
          Download
        </a>
        <a class="btn btn-secondary" href="#how">See how it works</a>
      </div>
      <ul class="facts" aria-label="At a glance">
        <li><Icon name="check" />Windows 10/11 and macOS 13+</li>
        <li><Icon name="check" />MIT licensed, free</li>
        <li><Icon name="check" />No accounts, no telemetry, no network calls</li>
      </ul>
    </div>
    <div class="visual">
      <HeroMonitor />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--space-xl) var(--space-xl);
  }

  /* Soft brand glows. Decorative only. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -10% -10% 10% -10%;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(45% 55% at 18% 25%, var(--glow-1), transparent 70%),
      radial-gradient(40% 50% at 85% 70%, var(--glow-2), transparent 70%);
  }

  .grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .copy {
    max-width: 40rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-m);
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--grad-brand);
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    /* Descenders in the gradient word get clipped by background-clip without this. */
    padding-bottom: 0.08em;
  }

  .lead {
    margin-top: var(--space-m);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .facts {
    display: grid;
    gap: var(--space-2xs);
    margin-top: var(--space-l);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .facts li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
  }

  .facts :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
    color: var(--color-accent-2);
  }

  .btn :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
  }

  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-2xl);
    }
  }
</style>
