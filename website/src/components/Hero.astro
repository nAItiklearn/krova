---
import Desk from './illustrations/Desk.astro';
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { RELEASE_PUBLISHED, VERSION_LABEL } from '../site';

const status = RELEASE_PUBLISHED ? `${VERSION_LABEL}, early software` : `${VERSION_LABEL}, not released yet`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="copy">
      <p class="status">
        <a class="pill pill--warn" href={url('/changelog/')}>
          <span class="dot" aria-hidden="true"></span>{status}
          <span class="more">What is in it <Icon name="arrow" /></span>
        </a>
      </p>

      <h1 id="hero-title">
        Draw your
        <span class="chip zones-chip" aria-hidden="true">
          <svg viewBox="0 0 40 24" width="40" height="24" focusable="false">
            <rect x="1" y="1" width="9" height="22" rx="2.5"></rect>
            <rect x="12" y="1" width="16" height="22" rx="2.5" class="on"></rect>
            <rect x="30" y="1" width="9" height="22" rx="2.5"></rect>
          </svg>
        </span>
        zones.
        <span class="soft line">Hold <span class="nw"><kbd class="chip">Shift</kbd>,</span> drop a window in.</span>
      </h1>

      <p class="lead">
        Krova is a free window zone manager for Windows 10/11 and macOS 13+. Drag a window, hold a key, release over a
        zone, and it snaps to fit. On Windows it also moves windows between zones from the keyboard and puts them back
        when a monitor returns. No account, no telemetry, no network calls by design.
      </p>

      <div class="actions">
        <a class="btn btn-primary" href={url('/download/')}>
          <Icon name="download" />
          Download
        </a>
        <a class="btn btn-secondary" href="#try">
          Try the editor
          <Icon name="arrow" />
        </a>
      </div>
      <p class="fine">Free &middot; MIT license &middot; Windows 10/11 &middot; macOS 13+ (untested on a real Mac)</p>
    </div>

    <figure class="stage">
      <input type="checkbox" id="hero-pause" class="ill-pause-input visually-hidden" />
      <Desk
        state="hero"
        stand
        label="Illustration of a desktop with a layout of three vertical zones. A window is dragged while Shift is held, the zone under it lights up, and on release the window fills that zone."
      />
      <figcaption class="ill-caption">
        <span>Illustration, not a screenshot. Shift is held while the window is dragged; releasing over a zone snaps it.</span>
        <label class="ill-pause" for="hero-pause">
          <svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1"></rect><rect x="7" y="1" width="3" height="10" rx="1"></rect></svg>
          <svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z"></path></svg>
          <span class="t-pause">Pause animation</span><span class="t-play">Play animation</span>
        </label>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1rem + 5vw, 5rem) clamp(3rem, 1.5rem + 5vw, 6rem);
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .status {
    margin-bottom: var(--space-l);
  }
  .status a {
    text-decoration: none;
  }
  .status .more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.35rem;
    padding-left: 0.7rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-link);
  }
  .status .more :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
  }

  h1 {
    max-width: 22ch;
    font-size: clamp(2.35rem, 0.9rem + 5.2vw, 4.4rem);
    letter-spacing: -0.045em;
    line-height: 1.04;
  }
  h1 .line {
    display: block;
  }
  h1 .nw {
    white-space: nowrap;
  }

  /* Inline UI chips inside the headline. */
  h1 .chip {
    margin-inline: 0.04em;
    transform: translateY(-0.04em);
  }
  .zones-chip {
    padding: 0.12em 0.2em;
  }
  .zones-chip svg {
    width: 0.95em;
    height: auto;
  }
  .zones-chip rect {
    fill: var(--accent-tint);
    stroke: var(--color-border-strong);
    stroke-width: 1.4;
  }
  .zones-chip rect.on {
    fill: var(--accent-tint-strong);
    stroke: var(--color-accent);
    stroke-width: 2;
  }
  h1 kbd.chip {
    min-width: 0;
    padding: 0.1em 0.38em 0.08em;
    border-bottom-width: 0.08em;
    font-family: inherit;
    font-size: 0.62em;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .lead {
    margin-top: var(--space-m);
    max-width: 38rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .fine {
    margin-top: var(--space-s);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .stage {
    max-width: 60rem;
    margin: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) auto 0;
  }
</style>
