---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Shot from './Shot.astro';
import ZoneScene from './ZoneScene.astro';
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { REPO_LINKS_ENABLED, REPO_URL } from '../site';

/**
 * The feature grid. Each card has a small picture: a real cropped screenshot of Krova's own UI where the
 * feature has a control in the UI, otherwise a flat diagram built from Krova's zone shapes. Diagrams say
 * "Diagram" in their label. The licence card shows the first lines of the repository's LICENSE file.
 */
const licenseLines = readFileSync(resolve(process.cwd(), '../LICENSE'), 'utf8')
  .replace(/\r\n/g, '\n')
  .trim()
  .split('\n')
  .filter((l) => l.trim() !== '')
  .slice(0, 2);
---

<section id="features" class="section" aria-labelledby="features-title">
  <div class="container">
    <header class="sec-head">
      <p class="eyebrow">Features</p>
      <h2 id="features-title">What it does. <span class="soft">Windows-only parts are marked.</span></h2>
    </header>

    <ul class="grid">
      <li class="card wide">
        <div class="art">
          <div class="crop">
            <Shot
              name="crop-zones"
              alt="The zone editor: three zones on a monitor, the middle one selected, and a dashed guide at 50 percent."
            />
          </div>
        </div>
        <h3>Zones you draw</h3>
        <p>
          Start from halves, thirds, a 2x2 grid or priority, or split zones and drag the dividers until it fits. Undo as
          you go.
        </p>
      </li>

      <li class="card wide">
        <div class="art">
          <ZoneScene
            state="drag"
            layout="thirds"
            target={1}
            label="Diagram: a window is dragged over the middle zone of a three-zone layout while Shift is held."
          />
        </div>
        <h3>Hold a key, drop in a zone</h3>
        <p>
          Hold Shift, Ctrl, Alt or the Windows key while you drag. Release over a zone to snap. Edge snapping for halves
          and quarters is there too, off by default.
        </p>
      </li>

      <li class="card">
        <div class="art">
          <div class="crop">
            <Shot
              name="crop-layouts"
              alt="The list of layouts on a monitor: Halves, Thirds, Grid 2x2 and Priority, each with a small preview. Halves is marked Active."
            />
          </div>
        </div>
        <h3>A layout for every monitor</h3>
        <p>Each monitor keeps its own layouts. Zones are proportions, so a layout survives a new resolution or scaling.</p>
      </li>

      <li class="card">
        <div class="art">
          <div class="crop">
            <Shot
              name="crop-keyboard"
              alt="Keyboard shortcuts: Ctrl+Alt+Shift with Left, Right, 1 to 9 or Up moves the focused window to the previous zone, the next zone, a numbered zone or the next monitor."
            />
          </div>
        </div>
        <h3>Keyboard zone control <span class="tag">Windows</span></h3>
        <p>Step through zones, jump to one by number, or send a window to the next monitor. Pick other keys if these are taken.</p>
      </li>

      <li class="card">
        <div class="art">
          <div class="crop">
            <Shot
              name="crop-memory"
              alt="The setting Restore windows on reconnect, switched on: when a monitor comes back, windows you snapped to it return to their zones. Kept in memory only."
            />
          </div>
        </div>
        <h3>Windows come back <span class="tag">Windows</span></h3>
        <p>
          When a monitor returns, the windows you snapped there go back into their zones. Memory only, no window titles.
          Tested with a simulated monitor change, not yet a real unplug.
        </p>
      </li>

      <li class="card">
        <div class="art">
          <ZoneScene
            state="dividers"
            label="Diagram: two snapped windows share an edge. The edge is dragged to the right and the neighbour follows."
          />
        </div>
        <h3>Linked dividers <span class="tag tag--warn">Windows, early</span></h3>
        <p>
          Resize a snapped window by its edge and the windows that share it follow. Works in tests; not yet confirmed
          with a real mouse.
        </p>
      </li>

      <li class="card">
        <div class="art">
          <ZoneScene
            state="gap"
            layout="thirds"
            label="Diagram: three snapped windows with 12 pixels between the zones."
          />
        </div>
        <h3>Space between zones</h3>
        <p>Leave 0 to 32 px around snapped windows, or none.</p>
      </li>

      <li class="card">
        <div class="art">
          <div class="crop crop--cut">
            <Shot
              name="crop-export"
              alt="Export and import: the Export layout button has been used and the layout is shown as plain text, with a Copy button."
            />
          </div>
        </div>
        <h3>Layout files</h3>
        <p>Copy a layout as plain text and paste it on another monitor or computer. One text fits any screen.</p>
      </li>

      <li class="card wide">
        <div class="art art--line">
          <div class="crop crop--line">
            <Shot
              name="crop-footer"
              alt="The line at the bottom of Krova's window: MIT licensed, no accounts, no telemetry, nothing leaves your computer."
            />
          </div>
        </div>
        <h3>Private and offline</h3>
        <p>
          No account, no telemetry, no update checks, and no network calls by design. Window titles are never read or
          stored. <a href={url('/privacy/')}>Read the details</a>.
        </p>
      </li>

      <li class="card wide">
        <div class="art art--line">
          <pre class="license" aria-label="The first lines of the MIT license file"><code>{licenseLines.join('\n')}</code></pre>
        </div>
        <h3>Free and open source</h3>
        <p>
          MIT license: use it, change it, share it. Nothing to buy.
          <a href={url('/license/')}>License and terms</a>{
            REPO_LINKS_ENABLED && (
              <Fragment>
                {' '}&middot; <a href={REPO_URL}>Source code <Icon name="external" /></a>
              </Fragment>
            )
          }.
        </p>
      </li>
    </ul>

    <p class="also">
      Also: a tray icon with launch at login. Light and dark follow your system. Minimized, fullscreen and administrator
      windows are skipped.
    </p>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-s);
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    box-shadow: none;
  }

  .art {
    display: grid;
    place-items: center;
    height: 16rem;
    margin-bottom: var(--space-s);
    padding: 1rem;
    border-radius: var(--radius-m);
    background: var(--color-surface-2);
  }
  .art :global(.scene) {
    max-width: 17rem;
  }
  .art .crop {
    --crop-h: 14rem;
  }
  .wide .art {
    height: 17rem;
  }
  .wide .art :global(.scene) {
    max-width: 22rem;
  }
  .wide .art .crop {
    --crop-h: 15rem;
  }

  .art.art--line {
    height: auto;
    padding-block: var(--space-l);
  }

  /* A tall crop is cut, not shrunk: the top of the panel at full size. */
  .crop--cut {
    width: 18rem;
    height: 14rem;
  }
  .crop--cut :global(img) {
    width: 100%;
    max-height: none;
    object-fit: cover;
    object-position: top;
  }
  .crop--line {
    max-width: 38rem;
  }

  .license {
    width: 100%;
    max-width: 22rem;
    margin: 0;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    font-size: var(--text-sm);
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .card h3 {
    padding-inline: var(--space-xs);
    font-size: var(--text-md);
  }

  .card p {
    margin-top: var(--space-2xs);
    padding: 0 var(--space-xs) var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .card p :global(.icon) {
    display: inline;
    width: 0.85em;
    height: 0.85em;
    vertical-align: -0.05em;
  }

  .tag {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
    vertical-align: 0.1em;
    white-space: nowrap;
  }
  .tag--warn {
    background: var(--color-warn-bg);
    border-color: var(--color-warn-border);
    color: var(--color-text);
  }

  .also {
    max-width: 44rem;
    margin: var(--space-l) auto 0;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wide {
      grid-column: 1 / -1;
    }
  }
  /* Six columns: wide cards take three, the rest take two. */
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .card {
      grid-column: span 2;
    }
    .card.wide {
      grid-column: span 3;
    }
  }
</style>
