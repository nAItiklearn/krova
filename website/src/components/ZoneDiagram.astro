---
/**
 * Small monitor diagram for the "how it works" steps. The three zones echo the
 * Krova icon: one tall zone on the left, two stacked zones on the right.
 *
 * variant "editor": zones with a draggable divider handle
 * variant "drag":   a window hovers over the lower-right zone, which is lit
 * variant "snap":   the window fills the lower-right zone
 *
 * Decorative: the step text next to it carries the meaning.
 */
interface Props {
  variant: 'editor' | 'drag' | 'snap';
}

const { variant } = Astro.props;

// Zone rectangles in SVG units (screen area is 16,16 -> 304,184, 6 unit gaps).
const zones = [
  { x: 16, y: 16, w: 141, h: 168 }, // A: left, full height
  { x: 163, y: 16, w: 141, h: 81 }, // B: upper right
  { x: 163, y: 103, w: 141, h: 81 }, // C: lower right
];
const target = zones[2];
const litIndex = variant === 'editor' ? -1 : 2;

// Window rectangle for the two window variants.
const win =
  variant === 'snap'
    ? { ...target }
    : variant === 'drag'
      ? { x: 188, y: 116, w: 104, h: 64 }
      : null;
const tilt = variant === 'drag' ? -4 : 0;
---

<svg class="diagram" viewBox="0 0 320 200" width="320" height="200" aria-hidden="true" focusable="false">
  <rect class="bezel" width="320" height="200" rx="14"></rect>
  <rect class="screen" x="8" y="8" width="304" height="184" rx="8"></rect>

  {
    zones.map((z, i) => (
      <rect
        class:list={['zone', { lit: i === litIndex }]}
        x={z.x}
        y={z.y}
        width={z.w}
        height={z.h}
        rx="7"
      />
    ))
  }

  {
    variant === 'editor' && (
      <g>
        <line class="divider" x1="163" y1="100" x2="304" y2="100"></line>
        <circle class="handle" cx="233" cy="100" r="8"></circle>
        <path class="grip" d="M229.5 100h7M233 96.5v7"></path>
      </g>
    )
  }

  {
    win && (
      <g transform={`rotate(${tilt} ${win.x + win.w / 2} ${win.y + win.h / 2})`}>
        <rect class="win-body" x={win.x} y={win.y} width={win.w} height={win.h} rx="7"></rect>
        <path
          class="win-bar"
          d={`M${win.x} ${win.y + 14}V${win.y + 7}a7 7 0 0 1 7-7H${win.x + win.w - 7}a7 7 0 0 1 7 7V${win.y + 14}z`}
        ></path>
        <circle class="win-dot" cx={win.x + 10} cy={win.y + 7} r="2.4"></circle>
        <circle class="win-dot" cx={win.x + 18} cy={win.y + 7} r="2.4"></circle>
        <rect class="win-line" x={win.x + 10} y={win.y + 24} width={win.w * 0.55} height="5" rx="2.5"></rect>
        <rect class="win-line" x={win.x + 10} y={win.y + 35} width={win.w * 0.75} height="4" rx="2"></rect>
        <rect class="win-line" x={win.x + 10} y={win.y + 44} width={win.w * 0.65} height="4" rx="2"></rect>
      </g>
    )
  }

  {
    variant === 'drag' && (
      <path class="cursor" d="M0 0v13l3.3-3 2.4 5.4 2-.8-2.3-5.3H10.5z" transform="translate(232 124)"></path>
    )
  }
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
  }
  .bezel {
    fill: var(--mon-bezel);
  }
  .screen {
    fill: var(--mon-screen);
  }
  .zone {
    fill: var(--zone-fill);
    stroke: var(--zone-stroke);
    stroke-width: 1.25;
    stroke-dasharray: 5 5;
  }
  .zone.lit {
    fill: var(--zone-hi-fill);
    stroke: var(--zone-hi-stroke);
    stroke-width: 2;
    stroke-dasharray: none;
  }
  .divider {
    stroke: var(--zone-hi-stroke);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .handle {
    fill: var(--color-accent);
    stroke: var(--mon-screen);
    stroke-width: 2;
  }
  .grip {
    stroke: #ffffff;
    stroke-width: 1.6;
    stroke-linecap: round;
    fill: none;
  }
  .win-body {
    fill: var(--win-bg);
    stroke: var(--win-stroke);
    stroke-width: 1.25;
  }
  .win-bar {
    fill: var(--win-bar);
  }
  .win-dot,
  .win-line {
    fill: var(--win-line);
  }
  .cursor {
    fill: var(--cursor-fill);
    stroke: var(--cursor-stroke);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
</style>
