---
import { faq } from '../data/faq';
import { inline } from '../lib/inline';
import { url } from '../lib/url';
import { ISSUES_URL, REPO_LINKS_ENABLED } from '../site';
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container wrap">
    <header class="head">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Questions</h2>
      <p class="muted">
        Something else? Check <a href={url('/support/')}>Troubleshooting</a>{
          REPO_LINKS_ENABLED ? (
            <Fragment> or <a href={ISSUES_URL}>open an issue</a></Fragment>
          ) : (
            <Fragment>. Krova&rsquo;s repository is not public yet, so there is nowhere to file an issue yet</Fragment>
          )
        }.
      </p>
    </header>

    <div class="groups">
      {
        faq.map((g, gi) => ({ ...g, items: g.items.slice(0, gi === 0 ? 4 : 2) })).map((g) => (
          <div class="group">
            <h3>{g.title}</h3>
            <div class="items">
              {g.items.map((it) => (
                <details>
                  <summary>
                    <span>{it.q}</span>
                    <i aria-hidden="true" />
                  </summary>
                  <p set:html={inline(it.a)} />
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .wrap {
    max-width: 46rem;
  }
  .head {
    text-align: center;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .head h2 {
    font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4rem);
    font-weight: 740;
    letter-spacing: -0.048em;
  }
  .head .muted {
    margin: var(--space-s) auto 0;
    max-width: 30rem;
    font-size: var(--text-sm);
  }
  .group + .group {
    margin-top: var(--space-l);
  }
  .group h3 {
    margin-bottom: 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-soft);
  }
  details {
    border-bottom: 1px solid var(--color-border);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: 1.05rem 0;
    font-size: var(--text-md);
    font-weight: 560;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s ease;
  }
  summary:hover {
    color: var(--color-accent-text);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* plus that turns into a minus */
  summary i {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }
  summary i::before,
  summary i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.8rem;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  }
  summary i::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] summary i::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  details p {
    padding: 0 0 1.15rem;
    max-width: 60ch;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    animation: faq-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  details p :global(a) {
    text-decoration: underline;
  }
</style>
