---
import { faq } from '../data/faq';
import { inline } from '../lib/inline';
import { url } from '../lib/url';
import { ISSUES_URL, REPO_LINKS_ENABLED } from '../site';
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container wrap">
    <header class="head">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Frequently asked <span class="soft">questions</span></h2>
      <p class="muted">
        Something else? Check <a href={url('/support/')}>Troubleshooting</a>{
          REPO_LINKS_ENABLED ? (
            <Fragment> or <a href={ISSUES_URL}>open an issue</a></Fragment>
          ) : (
            <Fragment>. Krova&rsquo;s repository is not public yet, so there is nowhere to file an issue yet</Fragment>
          )
        }.
      </p>
    </header>

    <div class="groups">
      {
        faq.map((g) => (
          <div class="group card">
            <h3>{g.title}</h3>
            <div class="items">
              {g.items.map((it) => (
                <details>
                  <summary>
                    <span>{it.q}</span>
                    <i aria-hidden="true" />
                  </summary>
                  <p set:html={inline(it.a)} />
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .head h2 {
    font-size: var(--text-2xl);
  }
  .head .muted {
    margin-top: var(--space-s);
    max-width: 24rem;
    font-size: var(--text-sm);
  }

  .groups {
    display: grid;
    gap: var(--space-s);
  }

  .group {
    padding: var(--space-s);
    border-radius: var(--radius-xl);
  }
  .group h3 {
    padding: 0.4rem 0.6rem 0.8rem;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-text-soft);
  }

  .items {
    display: grid;
    gap: 0.4rem;
  }

  details {
    border-radius: var(--radius-m);
    background: var(--color-surface-2);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  details[open] {
    background: var(--color-surface-3);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 3.25rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-m);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline-offset: 0;
  }

  /* plus / minus drawn with two bars */
  summary i {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-surface-3);
  }
  details[open] summary i {
    background: var(--color-surface);
  }
  summary i::before,
  summary i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.65rem;
    height: 2px;
    border-radius: 1px;
    background: var(--color-text);
    transform: translate(-50%, -50%);
    transition: transform var(--dur) var(--ease-out);
  }
  summary i::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] summary i::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  details p {
    padding: 0 0.9rem 1rem;
    max-width: 60ch;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  details p :global(a) {
    text-decoration: underline;
  }

  @media (min-width: 60rem) {
    .wrap {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: var(--space-2xl);
    }
    .head {
      position: sticky;
      top: 6rem;
    }
  }
</style>
