---
import Icon from './Icon.astro';
import { url } from '../lib/url';

const demo = url('/demo/');
---

<section id="try" class="section" aria-labelledby="try-title">
  <div class="container">
    <header class="sec-head">
      <p class="eyebrow">Try it live</p>
      <h2 id="try-title">Try the editor. <span class="soft">No install needed.</span></h2>
      <p class="lead">
        This is the real editor running on sample monitors. Nothing is saved to your computer&rsquo;s windows; snapping
        itself needs the app.
      </p>
    </header>

    <div class="frame">
      <div class="bar">
        <span class="label">Live demo &middot; two sample monitors &middot; Editor and Settings tabs</span>
        <a href={demo}>Open in its own tab <Icon name="external" /></a>
      </div>
      <iframe
        data-demo
        src={demo}
        title="Krova layout editor, live demo on sample monitors"
        loading="lazy"
        width="1000"
        height="720"></iframe>
      <noscript>
        <p class="ns">The live editor needs JavaScript. <a href={demo}>Open it in its own tab</a> with JavaScript enabled.</p>
      </noscript>
    </div>

    <ul class="notes">
      <li>Try a template, split a zone with <kbd>V</kbd> or <kbd>H</kbd>, drag a divider, or delete a zone.</li>
      <li>Your edits are kept in this browser&rsquo;s local storage only. Nothing is sent anywhere.</li>
      <li>The demo has its own Theme setting, under Settings.</li>
    </ul>
  </div>
</section>

<style>
  .frame {
    max-width: 66rem;
    margin-inline: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding: 0.6rem var(--space-m);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
    font-size: var(--text-sm);
  }
  .label {
    color: var(--color-text-muted);
  }
  .bar a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    font-weight: 600;
  }
  .bar :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  iframe {
    display: block;
    width: 100%;
    height: 50rem;
    border: 0;
    background: var(--color-surface);
  }

  .ns {
    padding: var(--space-m);
  }

  .notes {
    display: grid;
    gap: var(--space-2xs);
    max-width: 66rem;
    margin: var(--space-m) auto 0;
    padding-inline: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .notes li::before {
    content: '\2022';
    margin-right: 0.6rem;
    color: var(--color-text-soft);
  }

  @media (max-width: 40rem) {
    iframe {
      height: 52rem;
    }
  }
</style>
