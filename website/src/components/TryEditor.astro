---
import Icon from './Icon.astro';
import { url } from '../lib/url';

const demo = url('/demo/');
---

<section id="try" class="section" aria-labelledby="try-title">
  <div class="container">
    <header class="sec-head">
      <p class="eyebrow">Try it live</p>
      <h2 id="try-title">Try the editor. <span class="soft">No install needed.</span></h2>
      <p class="lead">
        This is the real editor running in your browser on two sample monitors. Snapping itself needs the app, so nothing
        here touches your windows.
      </p>
    </header>

    <div class="frame">
      <div class="bar">
        <img src={url('/favicon.svg')} width="16" height="16" alt="" />
        <span class="label">Krova &middot; live demo &middot; Editor and Settings tabs</span>
        <a href={demo}>Open in its own tab <Icon name="external" /></a>
      </div>
      <iframe
        data-demo
        src={demo}
        title="Krova layout editor, live demo on sample monitors"
        loading="lazy"
        width="1000"
        height="720"></iframe>
      <noscript>
        <p class="ns">The live editor needs JavaScript. <a href={demo}>Open it in its own tab</a> with JavaScript enabled.</p>
      </noscript>
    </div>

    <ul class="notes">
      <li>Try a template, split a zone with <kbd>V</kbd> or <kbd>H</kbd>, drag a divider, or delete a zone.</li>
      <li>Your edits stay in this browser&rsquo;s local storage. Nothing is sent anywhere.</li>
      <li>The demo has its own Theme setting, under Settings.</li>
    </ul>
  </div>
</section>

<style>
  .frame {
    max-width: 66rem;
    margin-inline: auto;
    border: 1px solid var(--win-edge);
    border-radius: var(--radius-m);
    background: var(--win-bar);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem 0.75rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.5rem 0.25rem 0.75rem;
    color: var(--win-bar-fg);
    font-size: 0.75rem;
  }
  .bar img {
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bar a {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding-inline: 0.5rem;
    color: var(--color-link);
    font-weight: 600;
    white-space: nowrap;
  }
  .bar :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
  }

  iframe {
    display: block;
    width: 100%;
    height: 50rem;
    border: 0;
    border-top: 1px solid var(--win-edge);
    background: var(--color-surface);
  }

  .ns {
    padding: var(--space-m);
  }

  .notes {
    display: grid;
    gap: var(--space-2xs);
    max-width: 66rem;
    margin: var(--space-m) auto 0;
    padding-inline: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .notes li::before {
    content: '\2022';
    margin-right: 0.6rem;
    color: var(--color-text-soft);
  }

  @media (max-width: 40rem) {
    iframe {
      height: 52rem;
    }
    .label {
      display: none;
    }
    .bar a {
      margin-left: auto;
    }
  }
</style>
