---
import { url } from '../lib/url';

/**
 * A neutral Windows-style window around its content (a screenshot or the live demo): a title bar with the app
 * icon, a title and the three window buttons. Decorative; the content is the real Krova UI.
 */
interface Props {
  title?: string;
  /** Rounded bottom corners and a bottom edge. Turn off when the window runs off the bottom of its stage. */
  closed?: boolean;
}

const { title = 'Krova', closed = true } = Astro.props;
---

<div class:list={['win', { open: !closed }]}>
  <div class="bar" aria-hidden="true">
    <img src={url('/favicon.svg')} width="16" height="16" alt="" />
    <span class="title">{title}</span>
    <span class="ctl">
      <svg viewBox="0 0 46 32" focusable="false"><path d="M18 16h10" /></svg>
      <svg viewBox="0 0 46 32" focusable="false"><rect x="18.5" y="11.5" width="9" height="9" rx="1.5" /></svg>
      <svg viewBox="0 0 46 32" focusable="false"><path d="M18.5 11.5l9 9M27.5 11.5l-9 9" /></svg>
    </span>
  </div>
  <div class="body"><slot /></div>
</div>

<style>
  .win {
    overflow: hidden;
    border: 1px solid var(--win-edge);
    border-radius: var(--radius-m);
    background: var(--win-bar);
    box-shadow: var(--shadow-2);
  }
  .win.open {
    border-bottom: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2rem;
    padding-left: 0.75rem;
    color: var(--win-bar-fg);
    font-size: 0.75rem;
    line-height: 1;
    user-select: none;
  }
  .bar img {
    width: 1rem;
    height: 1rem;
  }
  .title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ctl {
    display: flex;
    flex: none;
  }
  .ctl svg {
    width: 2.875rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
  }

  .body {
    border-top: 1px solid var(--win-edge);
    background: var(--color-surface);
    line-height: 0;
  }
  .body :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 40rem) {
    .ctl svg {
      width: 2.25rem;
    }
  }
</style>
