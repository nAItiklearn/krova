---
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { DOWNLOADS_ENABLED, MAC_RELEASED } from '../site';
---

<section class="cta section" aria-labelledby="cta-title">
  <div class="container">
    <img src={url('/favicon.svg')} width="64" height="64" alt="" />
    <h2 id="cta-title">Every window, <span class="soft">in its place.</span></h2>
    <p class="muted">
      {
        DOWNLOADS_ENABLED
          ? MAC_RELEASED
            ? 'Free. Windows and macOS.'
            : 'Free. For Windows 10 and 11.'
          : 'The first release is not published yet. The download page says what to expect and how to get past the unsigned-installer warnings.'
      }
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={url('/download/')}>
        <Icon name="download" />
        {MAC_RELEASED ? 'Download' : 'Download for Windows'}
      </a>
      <a class="btn btn-secondary" href={url('/#live')}>Try it live</a>
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
  }
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  img {
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-1);
  }
  h2 {
    margin-top: var(--space-l);
    font-size: var(--text-2xl);
  }
  .muted {
    max-width: 34rem;
    margin-top: var(--space-s);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }
</style>
