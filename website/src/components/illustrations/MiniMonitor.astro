---
import MockWin from './MockWin.astro';

/**
 * A small monitor showing one layout, for the reconnect story and the feature
 * cards. `off` draws it as a dashed outline (unplugged). `win` lists the zones
 * (by position in the layout, starting at 0) that hold a plain mock window.
 * Decorative: the text around it carries the meaning.
 */
interface Props {
  layout: 'priority' | 'grid' | 'halves' | 'thirds';
  off?: boolean;
  soft?: boolean;
  label?: string;
  win?: number[];
}

const { layout, off = false, soft = false, label, win = [] } = Astro.props;

type Z = { x: number; y: number; w: number; h: number };
const full = { y: 1.36, h: 97.28 };
const layouts: Record<Props['layout'], Z[]> = {
  priority: [
    { x: 0.8, w: 23.4, ...full },
    { x: 25.8, w: 48.4, ...full },
    { x: 75.8, w: 23.4, ...full },
  ],
  thirds: [
    { x: 0.8, w: 31.6, ...full },
    { x: 34.2, w: 31.6, ...full },
    { x: 67.6, w: 31.6, ...full },
  ],
  halves: [
    { x: 0.8, w: 48.6, ...full },
    { x: 50.6, w: 48.6, ...full },
  ],
  grid: [
    { x: 0.8, w: 48.6, y: 1.36, h: 47.9 },
    { x: 50.6, w: 48.6, y: 1.36, h: 47.9 },
    { x: 0.8, w: 48.6, y: 50.74, h: 47.9 },
    { x: 50.6, w: 48.6, y: 50.74, h: 47.9 },
  ],
};
const zones = layouts[layout];
const kinds = ['doc', 'page', 'term'] as const;
const windows = win.flatMap((i, n) => {
  const z = zones[i];
  return z ? [{ z, kind: kinds[n % kinds.length] }] : [];
});
---

<div class="mini ill-wrap" aria-hidden="true">
  <div class:list={['ill-monitor', 'ill-monitor--mini', { 'ill-monitor--off': off }]}>
    <div class="ill-desk">
      <div class="ill-work">
        {
          !off &&
            zones.map((z) => (
              <span
                class:list={['ill-zone', soft ? 'ill-zone--soft' : 'ill-zone--solid']}
                style={`--x:${z.x}%;--y:${z.y}%;--w:${z.w}%;--h:${z.h}%`}
              />
            ))
        }
        {
          !off &&
            windows.map(({ z, kind }) => (
              <MockWin
                kind={kind}
                x={`${(z.x + 1.4).toFixed(2)}%`}
                y={`${(z.y + 2.6).toFixed(2)}%`}
                w={`${(z.w - 2.8).toFixed(2)}%`}
                h={`${(z.h - 5.2).toFixed(2)}%`}
              />
            ))
        }
      </div>
    </div>
  </div>
  {label && <span class="mini-label">{label}</span>}
</div>

<style>
  .mini {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
  }
  .mini > :global(.ill-monitor) {
    width: 100%;
  }
  .mini-label {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }
</style>
