---
/**
 * Illustration of Krova's layout editor (monitor tabs, canvas with zones and a
 * divider, template picker). Built from the real editor's structure and labels
 * (ui/src/components/Editor.svelte, LayoutPanel.svelte), but it is a drawing,
 * not a screenshot. The live editor is at /demo/.
 */
const templates = [
  { name: 'Halves', zones: [{ x: 4, w: 45 }, { x: 51, w: 45 }] },
  { name: 'Thirds', zones: [{ x: 4, w: 29 }, { x: 35.5, w: 29 }, { x: 67, w: 29 }] },
  { name: 'Grid 2x2', grid: true },
  { name: 'Priority', on: true, zones: [{ x: 4, w: 21 }, { x: 27, w: 46 }, { x: 75, w: 21 }] },
];
---

<div class="ill-ed-wrap">
<div
  class="ill-ed"
  role="img"
  aria-label="Illustration of the layout editor: tabs for two monitors, a canvas with three zones and a draggable divider, and four templates (Halves, Thirds, Grid 2x2, Priority)."
>
  <div class="ill-ed__tabs" aria-hidden="true">
    <span class="is-on">Display 1 <small>2560 &times; 1440</small></span>
    <span>Display 2 <small>1920 &times; 1080</small></span>
  </div>
  <div class="ill-ed__body" aria-hidden="true">
    <div class="ill-ed__canvas">
      <span class="ill-ed__zone" style="--x:1.5%;--w:23%">1</span>
      <span class="ill-ed__zone is-sel" style="--x:26%;--w:48%">2</span>
      <span class="ill-ed__zone" style="--x:75.5%;--w:23%">3</span>
      <span class="ill-ed__div" style="--x:75%"><i></i></span>
    </div>
    <div class="ill-ed__side">
      <b>Templates</b>
      {
        templates.map((t) => (
          <div class:list={['ill-ed__tpl', { 'is-on': t.on }]}>
            <div class="ill-ed__thumb">
              {t.grid ? (
                <>
                  <i style="--x:4%;--y:8%;--w:44%;--h:40%" />
                  <i style="--x:52%;--y:8%;--w:44%;--h:40%" />
                  <i style="--x:4%;--y:52%;--w:44%;--h:40%" />
                  <i style="--x:52%;--y:52%;--w:44%;--h:40%" />
                </>
              ) : (
                t.zones?.map((z) => <i style={`--x:${z.x}%;--w:${z.w}%`} />)
              )}
            </div>
            <span>{t.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>
</div>
