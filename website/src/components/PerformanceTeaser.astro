---
import { idleStats, isEarlierBuild, loadMeasurements } from '../lib/measurements';
import { url } from '../lib/url';
import Icon from './Icon.astro';

/**
 * The home-page performance strip. Every number comes from docs/measurements/idle-*.txt, parsed at build time
 * (same loader as the Performance page): one cell per measured state of the current build, with private memory
 * as the headline. Runs of an earlier build stay on the Performance page; they are not shown here.
 */
const all = loadMeasurements();
const current = all.filter((m) => !isEarlierBuild(m.date));
const runs = (current.length > 0 ? current : all).map((m) => ({ m, s: idleStats(m) }));
const widest = Math.max(...runs.map(({ s }) => s.privateMedian));

const one = (x: number) => x.toFixed(1);
const two = (x: number) => x.toFixed(2);
const memory = (x: number) => (x >= 100 ? String(Math.round(x)) : one(x));
const plural = (k: number, a: string, b: string) => `${k} ${k === 1 ? a : b}`;
// Built here, not in the markup: whitespace between adjacent {expressions} would put a space before a comma.
const detail = (procs: number, cpu: number) =>
  `Private memory, ${plural(procs, 'process', 'processes')}${procs > 1 ? ', including the embedded web view' : ''}. Average CPU ${two(cpu)}% of one core.`;
// Width of the bar under each number, relative to the largest one. Never thinner than a visible sliver.
const bar = (x: number) => `${Math.max(1.5, (x / widest) * 100).toFixed(1)}%`;
---

<section id="performance" class="section" aria-labelledby="perf-title">
  <div class="container">
    <header class="sec-head">
      <p class="eyebrow">Performance</p>
      <h2 id="perf-title">Measured, not claimed. <span class="soft">Idle runs of the v0.1.0 installer.</span></h2>
    </header>

    <ul class="strip">
      {
        runs.map(({ m, s }) => (
          <li class="cell">
            <p class="state">{m.label}</p>
            <p class="big">
              {memory(s.privateMedian)} <span>MB</span>
            </p>
            <span class="track" aria-hidden="true">
              <i style={`width:${bar(s.privateMedian)}`} />
            </span>
            <p class="detail">{detail(m.processCount, s.cpuMean)}</p>
          </li>
        ))
      }
      <li class="cell cell--open">
        <p class="state">Not measured yet</p>
        <p class="big big--text">Drag latency</p>
        <p class="detail">Resource use while dragging, and macOS. These numbers will change.</p>
      </li>
    </ul>

    <div class="after">
      <p>One run each, 60 seconds idle with nothing being dragged, on one Windows PC. Not a benchmark against other tools.</p>
      <a class="btn btn-secondary" href={url('/performance/')}>
        Charts and method
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .strip {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }

  .cell {
    padding: var(--space-l) var(--space-m);
    border-top: 1px solid var(--color-border);
  }
  .cell:first-child {
    border-top: 0;
  }

  .state {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .big {
    margin-top: var(--space-xs);
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .big span {
    font-size: 0.4em;
    letter-spacing: 0;
    color: var(--color-text-soft);
  }
  .big--text {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    letter-spacing: -0.03em;
    color: var(--color-text-soft);
  }

  .track {
    display: block;
    height: 0.375rem;
    margin-top: var(--space-s);
    border-radius: var(--radius-pill);
    background: var(--color-surface-3);
  }
  .track i {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .detail {
    margin-top: var(--space-s);
    max-width: 24rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .big--text + .detail {
    margin-top: var(--space-s);
  }

  .after {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    max-width: 44rem;
    margin: var(--space-l) auto 0;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 52rem) {
    .strip {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
    .cell {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
    .cell:first-child {
      border-left: 0;
    }
  }
</style>
