---
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { guides, guidePath, navAfterGuides, navBeforeGuides } from '../data/nav';
import { REPO_LINKS_ENABLED, REPO_URL } from '../site';

const home = url('/');
const path = Astro.url.pathname;
const here = (href: string): boolean => {
  const target = url(href.split('#')[0]);
  return !href.includes('#') && path === target;
};
const inGuides = path.startsWith(url('/guides/'));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home} aria-label="Krova, home">
      <img src={url('/favicon.svg')} width="28" height="28" alt="" />
      <span>Krova</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          navBeforeGuides.map((l) => (
            <li>
              <a href={url(l.href)} aria-current={here(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <details class="dd" data-menu>
            <summary class:list={{ current: inGuides }}>
              Guides <Icon name="chevron" />
            </summary>
            <div class="dd-panel">
              <ul>
                {
                  guides.map((g) => (
                    <li>
                      <a href={url(guidePath(g.slug))} aria-current={path === url(guidePath(g.slug)) ? 'page' : undefined}>
                        {g.title}
                      </a>
                    </li>
                  ))
                }
                <li class="all">
                  <a href={url('/guides/')} aria-current={path === url('/guides/') ? 'page' : undefined}>All guides</a>
                </li>
              </ul>
            </div>
          </details>
        </li>
        {
          navAfterGuides.map((l) => (
            <li>
              <a href={url(l.href)} aria-current={here(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <button type="button" class="theme-btn" data-theme-toggle hidden aria-label="Switch theme">
        <span class="i-moon"><Icon name="moon" /></span>
        <span class="i-sun"><Icon name="sun" /></span>
      </button>
      {
        REPO_LINKS_ENABLED && (
          <a
            class="star"
            href={REPO_URL}
            target="_blank"
            rel="noopener"
            data-stars
            aria-label="Star Krova on GitHub (opens in a new tab)"
          >
            <svg class="gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              />
            </svg>
            <span class="star-label">Star</span>
            <span class="star-count" data-stars-count hidden></span>
          </a>
        )
      }
      <a class="btn btn-primary btn-sm" href={url('/download/')} aria-current={here('/download/') ? 'page' : undefined}>Download</a>

      <details class="mnav" data-menu>
        <summary>
          <Icon name="menu" />
          <span>Menu</span>
        </summary>
        <nav class="mnav-panel" aria-label="Mobile">
          <ul>
            {
              navBeforeGuides.map((l) => (
                <li><a href={url(l.href)}>{l.label}</a></li>
              ))
            }
            <li>
              <a href={url('/guides/')}>Guides</a>
              <ul class="sub">
                {guides.map((g) => <li><a href={url(guidePath(g.slug))}>{g.short}</a></li>)}
              </ul>
            </li>
            {
              navAfterGuides.map((l) => (
                <li><a href={url(l.href)}>{l.label}</a></li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    margin-right: auto;
    color: var(--color-text);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: var(--tracking-snug);
    text-decoration: none;
  }

  .nav-desktop {
    display: none;
  }

  .nav-desktop > ul {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .nav-desktop a,
  .dd > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.5rem;
    padding: 0 0.7rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }

  .dd > summary::-webkit-details-marker,
  .mnav > summary::-webkit-details-marker {
    display: none;
  }

  .nav-desktop a:hover,
  .dd > summary:hover,
  .dd[open] > summary,
  .dd > summary.current,
  .nav-desktop a[aria-current='page'] {
    color: var(--color-text);
    background: var(--color-surface-3);
  }

  .dd > summary :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .dd[open] > summary :global(.icon) {
    transform: rotate(180deg);
  }

  .dd {
    position: relative;
  }

  .dd-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    min-width: 14rem;
    padding: 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    box-shadow: var(--shadow-2);
    transform: translateX(-50%);
  }

  .dd-panel ul {
    display: grid;
  }

  .dd-panel a {
    display: flex;
    width: 100%;
    border-radius: var(--radius-s);
  }

  .dd-panel .all {
    margin-top: 0.3rem;
    padding-top: 0.3rem;
    border-top: 1px solid var(--color-border);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .actions .btn {
    min-height: 2.5rem;
  }

  .theme-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .theme-btn[hidden] {
    display: none;
  }
  .theme-btn:hover {
    color: var(--color-text);
    background: var(--color-surface-3);
  }
  .theme-btn :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .theme-btn .i-sun {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-btn .i-moon {
      display: none;
    }
    :global(:root:not([data-theme])) .theme-btn .i-sun {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .theme-btn .i-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-btn .i-sun {
    display: block;
  }

  /* ---- GitHub star link (count filled in by /stars.js) ---- */
  .star {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
  }
  .star:hover {
    color: var(--color-text);
    background: var(--color-surface-3);
  }
  .star .gh {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
  .star-count {
    padding-left: 0.45rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  .star-count[hidden] {
    display: none;
  }
  /* Narrow screens: icon and count only; the link keeps its aria-label. */
  @media (max-width: 40rem) {
    .star {
      padding: 0 0.7rem;
    }
    .star-label {
      display: none;
    }
    .star-count {
      padding-left: 0;
      border-left: 0;
    }
  }

  /* ---- Mobile menu ---- */
  .mnav > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .mnav > summary :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .mnav-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    padding: var(--space-s) var(--gutter) var(--space-m);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    box-shadow: var(--shadow-2);
  }
  .mnav-panel ul {
    display: grid;
  }
  .mnav-panel a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text);
    font-weight: 550;
    text-decoration: none;
  }
  .mnav-panel .sub {
    padding-left: var(--space-s);
    border-left: 1px solid var(--color-border);
    margin-bottom: var(--space-2xs);
  }
  .mnav-panel .sub a {
    color: var(--color-text-muted);
    font-weight: 450;
    min-height: 2.5rem;
  }

  /* Very narrow phones: the menu button keeps its icon, its label stays for screen readers. */
  @media (max-width: 26rem) {
    .mnav > summary {
      padding: 0;
      width: 2.5rem;
      justify-content: center;
    }
    .mnav > summary span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .bar {
      gap: var(--space-xs);
    }
  }

  @media (min-width: 60rem) {
    .site-header {
      position: sticky;
      top: 0;
      background: color-mix(in srgb, var(--color-bg) 88%, transparent);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
    }
    .nav-desktop {
      display: block;
    }
    .brand {
      margin-right: 0;
    }
    .actions {
      margin-left: auto;
    }
    .mnav {
      display: none;
    }
  }
</style>
