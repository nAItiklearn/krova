---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/illustrations.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../site';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Canonical / og:url only exist when src/site.ts provides a real origin.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Production-only CSP. It makes "no external requests" enforceable by the
// browser. Everything is denied except:
//   script-src 'self'  the one same-origin file, /theme.js
//   frame-src 'self'   the same-origin live demo at /demo/ (its own document, with its own CSP)
//   img-src 'self'     favicon and touch icon
//   connect-src 'self' audit tools fetch /robots.txt through the page
//   style-src inline   the stylesheet is inlined into each page
// Skipped in dev, where Vite needs a websocket for hot reload.
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'unsafe-inline'",
  "img-src 'self'",
  "connect-src 'self'",
  "frame-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c14" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Applies the saved light/dark choice before first paint. Same-origin file. -->
    <script is:inline src={url('/theme.js')}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
