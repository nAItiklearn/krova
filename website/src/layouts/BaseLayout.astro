---
import '@fontsource-variable/inter/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/illustrations.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { REPO_LINKS_ENABLED, SITE_NAME } from '../site';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Canonical / og:url only exist when src/site.ts provides a real origin.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Production-only CSP. It makes "no external requests, except the star count"
// enforceable by the browser. Everything is denied except:
//   script-src 'self'  the one same-origin file, /theme.js
//   frame-src 'self'   the same-origin live demo at /demo/ (its own document, with its own CSP)
//   img-src 'self'     favicon and touch icon
//   connect-src 'self' audit tools fetch /robots.txt through the page
//     + https://api.github.com: the one cross-origin request, the star count
//       in the header (/stars.js, cached for an hour)
//   style-src inline   the stylesheet is inlined into each page
// Skipped in dev, where Vite needs a websocket for hot reload.
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'unsafe-inline'",
  "img-src 'self'",
  "font-src 'self'",
  `connect-src 'self'${REPO_LINKS_ENABLED ? ' https://api.github.com' : ''}`,
  "frame-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f5f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Applies the saved light/dark choice before first paint. Same-origin file. -->
    <script is:inline src={url('/theme.js')}></script>
    <!-- GitHub star count for the header link. Deferred: never blocks rendering. -->
    {REPO_LINKS_ENABLED && <script is:inline defer src={url('/stars.js')}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Section heads rise in as they scroll into view (skipped with reduced motion).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const els = document.querySelectorAll<HTMLElement>('.sec-head, [data-reveal]');
        const io = new IntersectionObserver(
          (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => { el.classList.add('reveal'); io.observe(el); });
      }
    </script>
  </body>
</html>
