---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const title = 'Page not found: Krova';
const description = 'This page does not exist.';
---

<BaseLayout title={title} description={description}>
  <div class="container container--narrow">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>That page isn’t here</h1>
      <p class="lead">The address may be mistyped, or the page may have moved.</p>
      <p class="back"><a class="btn btn-primary" href={url('/')}>Back to the home page</a></p>
    </header>
  </div>
</BaseLayout>

<style>
  .back {
    margin-top: var(--space-m);
  }
  header {
    padding-bottom: var(--section-y);
  }
</style>
