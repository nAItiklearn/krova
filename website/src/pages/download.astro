---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
import {
  CHECKSUMS_FILE,
  DOWNLOADS,
  DOWNLOADS_ENABLED,
  MAC_RELEASED,
  RELEASES_URL,
  RELEASE_PUBLISHED,
  REPO_LINKS_ENABLED,
  REPO_URL,
  VERSION_LABEL,
  APP_VERSION,
  BETA_VERSION,
  BETA_DOWNLOADS_ENABLED,
  BETA_RELEASE_URL,
  betaDownloadUrl,
  latestDownloadUrl,
} from '../site';

const title = MAC_RELEASED
  ? 'Download Krova: Windows installer and macOS disk image'
  : 'Download Krova for Windows';
const description = MAC_RELEASED
  ? 'Krova is free and MIT licensed. The Windows installer and macOS disk image are unsigned: here is what to expect, how to get past the warnings, and how to check the download.'
  : `Krova is free and MIT licensed. Download v${APP_VERSION} (stable) or v${BETA_VERSION} (beta, a pre-release) for Windows. The installer is unsigned: here is how to get past the SmartScreen warning and check the download. macOS is coming once tested on real hardware.`;

const win = DOWNLOADS.find((d) => d.id === 'windows')!;
const mac = DOWNLOADS.find((d) => d.id === 'macos')!;

const state = DOWNLOADS_ENABLED ? 'released' : RELEASE_PUBLISHED ? 'private' : 'unreleased';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Download</p>
      <h1>Download Krova</h1>
      {
        MAC_RELEASED ? (
          <p class="lead">
            Free, MIT license, no account. Two builds: a Windows installer and a macOS disk image. Both are unsigned, so
            your system will warn you before the first run. Here is exactly what to expect.
          </p>
        ) : (
          <p class="lead">
            Free, MIT license, no account. Krova is available for Windows, as a stable release and as a beta. The
            installers are unsigned, so Windows will warn you before the first run; here is exactly what to expect. macOS
            support is coming once it has been tested on real hardware.
          </p>
        )
      }
    </header>

    {
      state === 'unreleased' && (
        <div class="note note--warn status">
          <p>
            <strong>The first release is not published yet.</strong> There is nothing to download today. This page is
            ready so you can see what each build needs before it exists. {VERSION_LABEL} is early software; the{' '}
            <a href={url('/changelog/')}>changelog</a> lists what it will contain and what it will not.
          </p>
          <p>
            In the meantime you can <a href={url('/#live')}>see it work in your browser</a>.
          </p>
        </div>
      )
    }
    {
      state === 'private' && (
        <div class="note note--warn status">
          <p>
            <strong>A release exists, but Krova&rsquo;s repository is not public yet,</strong> so this site has no
            public download link. This page will show the buttons once the repository is public.
          </p>
        </div>
      )
    }

    {
      state === 'released' && (
        <section class="versions" aria-labelledby="versions-title">
          <h2 id="versions-title" class="visually-hidden">Choose a version</h2>
          <article class="card version" aria-labelledby="stable-title">
            <header>
              <h3 id="stable-title">v{APP_VERSION}</h3>
              <p class="tag">Stable</p>
            </header>
            <p>
              The first release: zones you draw, Shift-drag to snap, keyboard shortcuts, layouts per monitor and layout files.
            </p>
            <div class="get">
              <a class="btn btn-primary" href={latestDownloadUrl(win.file)}>
                <Icon name="download" />
                Download v{APP_VERSION}
              </a>
            </div>
          </article>

          <article class="card version beta" aria-labelledby="beta-title">
            <header>
              <h3 id="beta-title">v{BETA_VERSION}</h3>
              <p class="tag tag--beta">Beta &middot; pre-release</p>
            </header>
            <p>
              Auto-arrange with stacks and swap, app rules, the notch and quick panel, the layout switcher, hot corners,
              workspaces, focus dim, calm desk, share-safe and rebindable shortcuts. Windows only.
            </p>
            <p class="muted small">
              It passes its automated tests, but most of it has not been tried by hand on a real PC yet. Expect bugs. Your
              v{APP_VERSION} settings and layouts load in the beta.
            </p>
            <div class="get">
              {
                BETA_DOWNLOADS_ENABLED ? (
                  <Fragment>
                    <a class="btn btn-primary" href={betaDownloadUrl(win.file)}>
                      <Icon name="download" />
                      Download the beta
                    </a>
                    <a class="btn btn-secondary" href={BETA_RELEASE_URL}>Release notes</a>
                  </Fragment>
                ) : (
                  <p class="pill pill--warn"><span class="dot" aria-hidden="true"></span>Not published yet</p>
                )
              }
            </div>
            <p class="smart small">
              The installer is unsigned. When Windows says &ldquo;Windows protected your PC&rdquo;, choose <strong>More info</strong>,
              then <strong>Run anyway</strong>.
            </p>
          </article>
        </section>
      )
    }

    <div class="builds">
      <article class="card build" aria-labelledby="win-title">
        <header>
          <h2 id="win-title">Windows</h2>
          <p class="req">{win.requirement}</p>
        </header>
        <p class="file"><code>{win.file}</code></p>

        <h3>What you get</h3>
        <ul>
          <li>An installer for one user. It does not ask for administrator rights.</li>
          <li>Krova goes into <code>%LOCALAPPDATA%\Krova</code>, with a Start menu shortcut. A desktop shortcut and &ldquo;Run Krova&rdquo; are offered on the last page.</li>
          <li>If Microsoft&rsquo;s WebView2 runtime is not on your PC, the installer downloads it. That download is the installer&rsquo;s, not Krova&rsquo;s.</li>
          <li>Krova starts in the notification area. No window opens by itself, and closing its window later closes the embedded browser too.</li>
          <li>Keyboard shortcuts are on by default: <kbd>Ctrl</kbd>+<kbd>Alt</kbd> with the arrow keys or 1 to 9 in the beta, <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>Shift</kbd> with Left, Right, Up or 1 to 9 in v{APP_VERSION}. Krova says so if another program holds one of them.</li>
          <li>In the beta, auto-arrange is on from the start: new windows go into the zones of the active layout. Switch it off under Arrange.</li>
        </ul>

        <h3>The SmartScreen warning</h3>
        <p>The installer is not code-signed, so Windows shows &ldquo;Windows protected your PC&rdquo;. To continue:</p>
        <ol>
          <li>Select <strong>More info</strong>.</li>
          <li>Select <strong>Run anyway</strong>.</li>
        </ol>
        <p class="muted small">
          If you would rather not, wait for a signed build, or build from source (below). Windows is warning about an
          unknown publisher, not about something it found inside the file.
        </p>

        <div class="get">
          {
            DOWNLOADS_ENABLED ? (
              <p class="muted small">
                Same file name for both versions. <a href="#versions-title">Choose a version</a> above.
              </p>
            ) : (
              <p class="pill pill--warn"><span class="dot" aria-hidden="true"></span>Not available yet</p>
            )
          }
        </div>
      </article>

      <article class="card build" aria-labelledby="mac-title">
        <header>
          <h2 id="mac-title">macOS</h2>
          <p class="req">{mac.requirement}, Apple silicon and Intel</p>
        </header>
        <p class="file"><code>{mac.file}</code></p>

        {
          MAC_RELEASED ? (
            <div class="note note--warn">
              <p><strong>Never tested on a real Mac.</strong> The macOS build has not been run on a Mac yet. Treat it as experimental.</p>
            </div>
          ) : (
            <div class="note note--warn">
              <p>
                <strong>macOS support is coming once it has been tested on real hardware.</strong> The macOS version is
                written and passes its automated checks, but it has never run on a Mac, so there is no download yet.
                What follows is how it is meant to work.
              </p>
            </div>
          )
        }

        <h3>What you get</h3>
        <ul>
          <li>A disk image. Open it and drag Krova to Applications.</li>
          <li>A menu bar icon, with no Dock icon.</li>
          <li>Snapping by dragging and edge snapping. No keyboard shortcuts and no window memory yet; those are Windows only for now.</li>
        </ul>

        <h3>Gatekeeper</h3>
        <p>The app is unsigned and not notarised, so macOS blocks the first launch. To open it:</p>
        <ol>
          <li>In Applications, right-click (or Control-click) <strong>Krova</strong> and choose <strong>Open</strong>.</li>
          <li>Choose <strong>Open</strong> in the dialog.</li>
        </ol>
        <p class="muted small">
          If the dialog has no Open button (newer macOS versions can do this), open System Settings, Privacy &amp;
          Security, scroll to Security, and choose <strong>Open Anyway</strong> next to Krova.
        </p>

        <h3>Permissions</h3>
        <p>
          Krova needs <strong>Accessibility</strong> access to move other apps&rsquo; windows (System Settings, Privacy
          &amp; Security, Accessibility). macOS may also ask for <strong>Input Monitoring</strong>. Without Accessibility,
          snapping cannot work, and a restart of Krova may be needed after you grant it.
        </p>

        <div class="get">
          {
            DOWNLOADS_ENABLED && MAC_RELEASED ? (
              <a class="btn btn-primary" href={latestDownloadUrl(mac.file)}>
                <Icon name="download" />
                Download for macOS
              </a>
            ) : (
              <p class="pill pill--warn">
                <span class="dot" aria-hidden="true"></span>
                {MAC_RELEASED ? 'Not available yet' : 'Coming after testing on a real Mac'}
              </p>
            )
          }
        </div>
      </article>
    </div>

    <div class="below prose">
      <h2 id="verify">Check your download</h2>
      <p>
        Each release publishes <code>{CHECKSUMS_FILE}</code> next to the installers (the beta&rsquo;s is on its
        release page): one SHA-256 hash per file.
        Compute the hash of what you downloaded and compare it with the line for that file.
      </p>
      <p><strong>Windows</strong> (PowerShell), from the folder with the file:</p>
      <pre tabindex="0"><code>Get-FileHash .\{win.file} -Algorithm SHA256</code></pre>
      {
        MAC_RELEASED && (
          <>
            <p><strong>macOS</strong> (Terminal):</p>
            <pre tabindex="0"><code>shasum -a 256 {mac.file}</code></pre>
          </>
        )
      }
      <p>
        The two should match exactly (letter case does not matter). A match proves the download was not corrupted on the
        way. It cannot prove who built the file, because the checksum comes from the same place as the file and the
        installers are unsigned.
      </p>

      <h2 id="source">Build from source</h2>
      {
        REPO_LINKS_ENABLED ? (
          <p>
            The code is open. Build instructions are in the <a href={REPO_URL}>repository README</a>, and all releases
            are on the <a href={RELEASES_URL}>releases page</a>.
          </p>
        ) : (
          <p>
            Building from source is the other way to get Krova, and the way to avoid the unsigned-installer warnings.
            The instructions are in the repository, which is not public yet.
          </p>
        )
      }

      <h2>After installing</h2>
      <p>
        <a href={url('/guides/install/')}>The install guide</a> covers the tray icon, the permissions, uninstalling and
        removing all of Krova&rsquo;s data. <a href={url('/guides/first-snap/')}>Your first snap</a> walks through the first drag.
        Linux is not supported.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .status {
    margin-bottom: var(--space-l);
  }

  .versions {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-m);
  }
  .version {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-xl);
  }
  .version header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
  }
  .version h3 {
    font-size: var(--text-xl);
  }
  .version .get {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-s);
  }
  .tag {
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    background: var(--color-surface-3);
    color: var(--color-text-muted);
  }
  .tag--beta {
    background: var(--accent-tint-strong);
    color: var(--color-accent-text);
  }
  .beta {
    box-shadow:
      inset 0 0 0 1.5px var(--color-ember),
      var(--shadow-1);
  }
  .smart {
    color: var(--color-text-muted);
  }

  .builds {
    display: grid;
    gap: var(--space-m);
  }

  .build {
    display: flex;
    flex-direction: column;
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-xl);
  }

  .build h2 {
    font-size: var(--text-xl);
  }
  .req {
    margin-top: var(--space-3xs);
    color: var(--color-text-muted);
  }
  .file {
    margin-top: var(--space-s);
  }

  .build h3 {
    margin-top: var(--space-l);
    margin-bottom: var(--space-2xs);
    font-size: var(--text-base);
  }

  .build ul,
  .build ol {
    display: grid;
    gap: var(--space-2xs);
    padding-left: 1.25em;
    list-style: disc;
  }
  .build ol {
    list-style: decimal;
  }
  .build .note {
    margin-top: var(--space-m);
  }
  .small {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
  }

  .get {
    margin-top: auto;
    padding-top: var(--space-l);
  }

  .below {
    margin-top: var(--space-2xl);
    padding-bottom: var(--section-y);
  }
  .below > h2:first-child {
    margin-top: 0;
  }

  @media (min-width: 56rem) {
    .versions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .version {
      padding: var(--space-xl) var(--space-l);
    }
    .builds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
    .build {
      padding: var(--space-xl) var(--space-l);
    }
  }
</style>
