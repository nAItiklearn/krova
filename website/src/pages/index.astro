---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import PrivacySection from '../components/PrivacySection.astro';
import Limitations from '../components/Limitations.astro';
import Download from '../components/Download.astro';
import Faq from '../components/Faq.astro';

const title = 'Krova: free, offline window zone manager for Windows and macOS';
const description =
  'Free, open-source, offline window zone manager for Windows 10/11 and macOS 13+. Hold Shift, drag a window, drop it in a zone. No accounts, no telemetry.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <HowItWorks />
  <Features />
  <PrivacySection />
  <Limitations />
  <Download />
  <Faq />
</BaseLayout>
