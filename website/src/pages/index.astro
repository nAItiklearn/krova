---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureTabs from '../components/FeatureTabs.astro';
import Customize from '../components/Customize.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { MAC_RELEASED } from '../site';

const title = MAC_RELEASED
  ? 'Krova: free, offline window zone manager for Windows and macOS'
  : 'Krova: free, offline window zone manager for Windows';
const description = MAC_RELEASED
  ? 'Draw zones on each monitor, hold Shift while dragging a window, release over a zone to snap. Keyboard shortcuts and windows that return to their zones on Windows. Free, MIT, offline, for Windows 10/11 and macOS 13+.'
  : 'Draw zones on each monitor, hold Shift while dragging a window, release over a zone to snap. Keyboard shortcuts and windows that return to their zones. Free, MIT, offline, for Windows 10/11. An early preview; macOS comes after testing on a real Mac.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <FeatureTabs />
  <Customize />
  <Faq />
  <FinalCta />
</BaseLayout>
