{
  "name": "krova-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Krova zone editor and settings UI (Svelte 5 + Vite + TypeScript)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "demo": "vite --mode demo",
